@implements IAsyncDisposable
@inject IJSRuntime JS

<div @ref="_root" class="searchable-select @CssClass @(_isOpen ? "searchable-select-open" : null)">
    <button type="button"
            class="form-select searchable-select-toggle text-start"
            disabled="@Disabled"
            aria-label="@AriaLabel"
            aria-haspopup="listbox"
            aria-controls="@_listboxId"
            aria-expanded="@_isOpen"
            @onclick="ToggleOpen">
        @SelectedLabel
    </button>
    @if (_isOpen)
    {
        <div class="searchable-select-menu border rounded shadow-sm">
            <input @ref="_searchInput"
                   type="search"
                   class="form-control searchable-select-search"
                   placeholder="@SearchPlaceholder"
                   aria-label="@SearchPlaceholder"
                   role="combobox"
                   aria-autocomplete="list"
                   aria-expanded="true"
                   aria-controls="@_listboxId"
                   autocomplete="off"
                   @bind="_searchTerm"
                   @bind:event="oninput"
                   @bind:after="OnSearchChanged"
                   @onkeydown="HandleSearchKeyDown" />
            <ul id="@_listboxId" class="list-unstyled mb-0 searchable-select-options" role="listbox">
                @foreach (var (option, index) in FilteredOptions.Select((option, index) => (option, index)))
                {
                    <li>
                        <button type="button"
                                class="searchable-select-option @(IsHighlighted(index) ? "active" : null)"
                                role="option"
                                aria-selected="@IsSelected(option)"
                                @onclick="() => SelectOptionAsync(option.Value)">
                            <span class="searchable-select-option-name">@option.Label</span>
                            @if (!string.IsNullOrWhiteSpace(option.SupportingText))
                            {
                                <span class="searchable-select-option-meta">@option.SupportingText</span>
                            }
                        </button>
                    </li>
                }
                @if (FilteredOptions.Count == 0)
                {
                    <li class="px-3 py-2 text-muted small">@EmptyText</li>
                }
            </ul>
        </div>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<SearchableSelectOption> Options { get; set; } = [];
    [Parameter] public string? SelectedValue { get; set; }
    [Parameter] public EventCallback<string?> SelectedValueChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Select an option...";
    [Parameter] public string SearchPlaceholder { get; set; } = "Search options...";
    [Parameter] public string EmptyText { get; set; } = "No options match";
    [Parameter] public string AriaLabel { get; set; } = "Select an option";
    [Parameter] public string CssClass { get; set; } = string.Empty;
    [Parameter] public bool Disabled { get; set; }

    private readonly string _listboxId = $"searchable-select-{Guid.NewGuid():N}";
    private ElementReference _root;
    private ElementReference _searchInput;
    private IJSObjectReference? _module;
    private DotNetObjectReference<SearchableSelect>? _dotNetRef;
    private IReadOnlyList<SearchableSelectOption> _filteredOptions = [];
    private bool _isOpen;
    private bool _shouldFocusSearch;
    private bool _outsideClickRegistered;
    private string _searchTerm = string.Empty;
    private int _highlightedIndex;

    private IReadOnlyList<SearchableSelectOption> FilteredOptions => _filteredOptions;

    private string SelectedLabel =>
        Options.FirstOrDefault(IsSelected)?.Label ?? Placeholder;

    protected override void OnParametersSet()
    {
        RefreshFilteredOptions();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/searchableSelect.js");

        if (_isOpen && _shouldFocusSearch)
        {
            _shouldFocusSearch = false;
            await _searchInput.FocusAsync();
        }

        if (_isOpen && !_outsideClickRegistered)
        {
            _dotNetRef ??= DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("registerOutsideClick", _root, _dotNetRef);
            _outsideClickRegistered = true;
        }
        else if (!_isOpen && _outsideClickRegistered)
        {
            await _module.InvokeVoidAsync("unregisterOutsideClick", _root);
            _outsideClickRegistered = false;
        }
    }

    private bool IsHighlighted(int index) => index == _highlightedIndex;

    private bool IsSelected(SearchableSelectOption option) =>
        option.Value == (SelectedValue ?? string.Empty);

    private void RefreshFilteredOptions()
    {
        var searchTerm = _searchTerm.Trim();
        _filteredOptions = string.IsNullOrEmpty(searchTerm)
            ? Options
            : Options
                .Where(option =>
                    option.Label.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
                    || (option.SupportingText?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false))
                .ToList();

        _highlightedIndex = _filteredOptions.Count == 0
            ? -1
            : Math.Clamp(_highlightedIndex, 0, _filteredOptions.Count - 1);
    }

    private void OnSearchChanged()
    {
        _highlightedIndex = 0;
        RefreshFilteredOptions();
    }

    private void ToggleOpen()
    {
        if (Disabled)
        {
            return;
        }

        if (_isOpen)
        {
            Close();
            return;
        }

        _isOpen = true;
        _searchTerm = string.Empty;
        _shouldFocusSearch = true;
        RefreshFilteredOptions();

        var selectedIndex = -1;
        for (var index = 0; index < _filteredOptions.Count; index++)
        {
            if (IsSelected(_filteredOptions[index]))
            {
                selectedIndex = index;
                break;
            }
        }

        _highlightedIndex = selectedIndex >= 0 ? selectedIndex : 0;
    }

    private void Close()
    {
        _isOpen = false;
        _searchTerm = string.Empty;
        _highlightedIndex = 0;
        RefreshFilteredOptions();
    }

    [JSInvokable]
    public Task CloseFromOutside()
    {
        if (!_isOpen)
        {
            return Task.CompletedTask;
        }

        Close();
        return InvokeAsync(StateHasChanged);
    }

    private async Task SelectOptionAsync(string value)
    {
        Close();
        await SelectedValueChanged.InvokeAsync(value);
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "Escape":
                Close();
                break;
            case "ArrowDown":
                if (FilteredOptions.Count > 0)
                {
                    _highlightedIndex = Math.Min(_highlightedIndex + 1, FilteredOptions.Count - 1);
                }
                break;
            case "ArrowUp":
                if (FilteredOptions.Count > 0)
                {
                    _highlightedIndex = Math.Max(_highlightedIndex - 1, 0);
                }
                break;
            case "Home":
                if (FilteredOptions.Count > 0)
                {
                    _highlightedIndex = 0;
                }
                break;
            case "End":
                if (FilteredOptions.Count > 0)
                {
                    _highlightedIndex = FilteredOptions.Count - 1;
                }
                break;
            case "Enter":
                if (_highlightedIndex >= 0 && _highlightedIndex < FilteredOptions.Count)
                {
                    await SelectOptionAsync(FilteredOptions[_highlightedIndex].Value);
                }
                break;
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module is not null && _outsideClickRegistered)
            {
                await _module.InvokeVoidAsync("unregisterOutsideClick", _root);
            }

            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }
        finally
        {
            _dotNetRef?.Dispose();
        }
    }
}
