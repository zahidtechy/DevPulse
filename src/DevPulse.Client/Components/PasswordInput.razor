<div class="password-field">
    <input @attributes="AdditionalAttributes"
           id="@Id"
           name="@Name"
           type="@(_isVisible ? "text" : "password")"
           class="form-control password-field-input @CssClass"
           value="@Value"
           @oninput="HandleInputAsync"
           autocomplete="@Autocomplete"
           placeholder="@Placeholder"
           disabled="@Disabled"
           spellcheck="false"
           autocapitalize="none"
           aria-describedby="@AriaDescribedBy" />
    <button type="button"
            class="password-field-toggle"
            aria-label="@ToggleLabel"
            aria-controls="@Id"
            title="@ToggleLabel"
            @onmousedown:preventDefault
            @onclick="ToggleVisibility">
        <span class="bi @(_isVisible ? "bi-eye-slash" : "bi-eye") password-field-icon" aria-hidden="true"></span>
    </button>
</div>

@code {
    private bool _isVisible;

    [Parameter]
    public string? Id { get; set; }

    [Parameter]
    public string? Name { get; set; }

    [Parameter]
    public string Value { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    [Parameter]
    public string? Autocomplete { get; set; }

    [Parameter]
    public string? Placeholder { get; set; }

    [Parameter]
    public string CssClass { get; set; } = string.Empty;

    [Parameter]
    public string? AriaDescribedBy { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string ToggleLabel => _isVisible ? "Hide password" : "Show password";

    private Task HandleInputAsync(ChangeEventArgs args)
        => ValueChanged.InvokeAsync(args.Value?.ToString() ?? string.Empty);

    private void ToggleVisibility()
        => _isVisible = !_isVisible;
}
