@implements IDisposable
@inject SessionState Session
@inject IAuthService AuthService
@inject ToastService Toast

@code {
    private bool _handling;

    protected override void OnInitialized()
    {
        Session.Expired += HandleExpired;
    }

    private void HandleExpired()
    {
        _ = InvokeAsync(SignOutAsync);
    }

    private async Task SignOutAsync()
    {
        if (_handling)
        {
            return;
        }

        _handling = true;

        try
        {
            // Failing requests on the current page will keep surfacing 401s for a moment.
            // Drop those toasts and suppress new ones until the user signs in again.
            Toast.SuppressErrors = true;
            Toast.Clear();

            // Ask the server to revoke and delete any remaining refresh session. If it is
            // already invalid or unavailable, AuthService still clears the access token.
            try
            {
                using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(3));
                await AuthService.LogoutAsync(timeout.Token);
            }
            catch
            {
                // The local session is already signed out; deleting the refresh cookie is best effort.
            }

            Toast.Info("Your session expired. Please sign in again.", key: ToastKeys.Session);
        }
        finally
        {
            _handling = false;
        }
    }

    public void Dispose()
    {
        Session.Expired -= HandleExpired;
    }
}
