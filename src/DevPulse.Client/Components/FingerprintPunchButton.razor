@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="fingerprint-punch @GetStateClass() @(IsDisabled ? "disabled" : null) @(IsLocked ? "fingerprint-punch-locked" : null) @(IsPressing ? "pressing" : null)">
    <button type="button"
            @ref="_button"
            class="fingerprint-punch-btn"
            disabled="@(IsDisabled || IsBusy || IsLocked)"
            aria-label="@GetLabel()"
            draggable="false"
            @onpointerdown="StartPress"
            @onpointerup="CancelPress"
            @onpointercancel="CancelPress">
        <svg class="fingerprint-progress" viewBox="0 0 120 120" aria-hidden="true">
            <circle class="fingerprint-progress-track" cx="60" cy="60" r="54" />
            <circle class="fingerprint-progress-ring" cx="60" cy="60" r="54" />
        </svg>
        <span class="fingerprint-icon bi-fingerprint" aria-hidden="true"></span>
    </button>
    <p class="fingerprint-label">@GetLabel()</p>
    @if (!string.IsNullOrWhiteSpace(Hint))
    {
        <p class="fingerprint-hint">@Hint</p>
    }
</div>

@code {
    private const int HoldDurationMs = 800;

    [Parameter]
    public AttendanceNextActionDto NextAction { get; set; } = AttendanceNextActionDto.PunchIn;

    [Parameter]
    public bool IsDisabled { get; set; }

    [Parameter]
    public bool IsBusy { get; set; }

    [Parameter]
    public bool IsLocked { get; set; }

    [Parameter]
    public string? Hint { get; set; }

    [Parameter]
    public EventCallback OnPunchComplete { get; set; }

    private ElementReference _button;
    private IJSObjectReference? _module;
    private IJSObjectReference? _guards;
    private bool IsPressing { get; set; }
    private bool _renderedPressing;
    private CancellationTokenSource? _pressCts;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _renderedPressing = IsPressing;

        if (_guards is not null)
        {
            return;
        }

        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/fingerprintPunch.js");
            _guards = await _module.InvokeAsync<IJSObjectReference>("attachHoldGuards", _button);
        }
        catch
        {
            // Punch still works without capture; mobile WebViews just become less reliable.
        }
    }

    protected override bool ShouldRender()
    {
        // Skip parent-driven rerenders while holding so mobile WebViews do not
        // cancel the pointer or restart the hold animation.
        if (IsPressing && _renderedPressing)
        {
            return false;
        }

        return true;
    }

    private string GetStateClass() => NextAction switch
    {
        AttendanceNextActionDto.PunchIn => "fingerprint-punch-in",
        AttendanceNextActionDto.PunchOut => "fingerprint-punch-out",
        AttendanceNextActionDto.Complete => "fingerprint-punch-complete",
        _ => string.Empty
    };

    private string GetLabel() => NextAction switch
    {
        AttendanceNextActionDto.PunchIn when IsLocked => "Punch In Locked",
        AttendanceNextActionDto.PunchIn => "Hold to Punch In",
        AttendanceNextActionDto.PunchOut when IsLocked => "Punch Out Locked",
        AttendanceNextActionDto.PunchOut => "Hold to Punch Out",
        AttendanceNextActionDto.Complete => "Day Complete",
        _ => "Hold to Punch"
    };

    private void StartPress(PointerEventArgs args)
    {
        if (IsDisabled || IsBusy || IsLocked || NextAction == AttendanceNextActionDto.Complete)
        {
            return;
        }

        if (args.PointerType == "mouse" && args.Button != 0)
        {
            return;
        }

        CancelPressInternal();
        IsPressing = true;
        _renderedPressing = false;
        _pressCts = new CancellationTokenSource();
        _ = RunHoldTimerAsync(_pressCts.Token);
    }

    private void CancelPress(PointerEventArgs args)
    {
        CancelPressInternal();
    }

    private void CancelPressInternal()
    {
        _pressCts?.Cancel();
        _pressCts?.Dispose();
        _pressCts = null;
        IsPressing = false;
        _renderedPressing = false;
    }

    private async Task RunHoldTimerAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(HoldDurationMs, cancellationToken);
            if (cancellationToken.IsCancellationRequested)
            {
                return;
            }

            CancelPressInternal();
            await OnPunchComplete.InvokeAsync();
        }
        catch (OperationCanceledException)
        {
            // Expected when the user releases early.
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    public async ValueTask DisposeAsync()
    {
        CancelPressInternal();

        if (_guards is not null)
        {
            try
            {
                await _guards.InvokeVoidAsync("dispose");
            }
            catch
            {
                // Ignored during teardown.
            }

            await _guards.DisposeAsync();
        }

        if (_module is not null)
        {
            await _module.DisposeAsync();
        }
    }
}
