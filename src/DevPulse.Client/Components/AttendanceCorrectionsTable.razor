@if (Requests.Count == 0)
{
    <div class="attendance-empty-state">
        <div class="attendance-empty-icon" aria-hidden="true"></div>
        <h5>No correction requests</h5>
        <p class="text-muted mb-0">@(AllowReview ? "There are no correction requests matching the current filters." : "You have not submitted any correction requests yet.")</p>
    </div>
}
else
{
    <div class="table-responsive card form-card attendance-table-card">
        <table class="table table-hover mb-0 attendance-table">
            <thead>
                <tr>
                    <th>Developer</th>
                    <th>Date</th>
                    <th>Punch in</th>
                    <th>Punch out</th>
                    <th>Reason</th>
                    <th>Status</th>
                    <th class="attendance-table-actions"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var request in Requests)
                {
                    <tr>
                        <td class="attendance-dev-name">@request.DeveloperName</td>
                        <td class="attendance-date-cell">@request.WorkDate.ToString("MMM d, yyyy")</td>
                        <td><span class="attendance-punch-time">@AttendanceFormatter.FormatTime(request.RequestedPunchInUtc, OfficeTimeZoneId)</span></td>
                        <td><span class="attendance-punch-time">@AttendanceFormatter.FormatTime(request.RequestedPunchOutUtc, OfficeTimeZoneId)</span></td>
                        <td class="attendance-reason-cell" title="@request.Reason">@TruncateReason(request.Reason)</td>
                        <td><span class="attendance-badge @AttendanceFormatter.CorrectionStatusClass(request.Status)">@AttendanceFormatter.CorrectionStatusLabel(request.Status)</span></td>
                        <td class="attendance-table-actions">
                            <div class="attendance-row-actions">
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => OnDetails.InvokeAsync(request.Id)">Details</button>
                                @if (CanCancel?.Invoke(request) == true)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => OnCancel.InvokeAsync(request.Id)">Cancel</button>
                                }
                                @if (AllowReview && request.Status == AttendanceCorrectionStatusDto.Pending)
                                {
                                    <button type="button" class="btn btn-sm btn-success" @onclick="() => OnApprove.InvokeAsync(request.Id)">Approve</button>
                                    <button type="button" class="btn btn-sm btn-danger" @onclick="() => OnReject.InvokeAsync(request.Id)">Reject</button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter]
    public IReadOnlyList<AttendanceCorrectionRequestDto> Requests { get; set; } = [];

    /// <summary>Decides whether the Cancel action applies to a given request.</summary>
    [Parameter]
    public Func<AttendanceCorrectionRequestDto, bool>? CanCancel { get; set; }

    [Parameter]
    public bool AllowReview { get; set; }

    [Parameter]
    public string OfficeTimeZoneId { get; set; } = "Asia/Dhaka";

    [Parameter]
    public EventCallback<Guid> OnDetails { get; set; }

    [Parameter]
    public EventCallback<Guid> OnCancel { get; set; }

    [Parameter]
    public EventCallback<Guid> OnApprove { get; set; }

    [Parameter]
    public EventCallback<Guid> OnReject { get; set; }

    // Keep the reason column compact; the full text is available on hover (title)
    // and in the row's details modal.
    private const int ReasonPreviewLength = 30;

    private static string TruncateReason(string? reason)
    {
        if (string.IsNullOrWhiteSpace(reason))
        {
            return "—";
        }

        var trimmed = reason.Trim();
        return trimmed.Length <= ReasonPreviewLength
            ? trimmed
            : $"{trimmed[..ReasonPreviewLength].TrimEnd()}…";
    }
}
