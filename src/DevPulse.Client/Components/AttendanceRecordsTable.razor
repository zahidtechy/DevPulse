@if (Records.Count == 0)
{
    <div class="attendance-empty-state">
        <div class="attendance-empty-icon" aria-hidden="true"></div>
        <h5>No attendance records</h5>
        <p class="text-muted mb-0">No records found for the selected date range.</p>
    </div>
}
else
{
    <div class="table-responsive card form-card attendance-table-card">
        <table class="table table-hover mb-0 attendance-table">
            <thead>
                <tr>
                    @if (ShowDeveloper)
                    {
                        <th>Developer</th>
                    }
                    <th>Date</th>
                    <th>Punch in</th>
                    <th>Punch out</th>
                    <th>Hours</th>
                    <th>Status</th>
                    @if (ShowAdminEdit)
                    {
                        <th class="attendance-table-actions"></th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var record in Records)
                {
                    <tr>
                        @if (ShowDeveloper)
                        {
                            <td class="attendance-dev-name">@record.DeveloperName</td>
                        }
                        <td class="attendance-date-cell">@record.WorkDate.ToString("MMM d, yyyy")</td>
                        <td>
                            <span class="attendance-punch-time">@FormatUtc(record.PunchInUtc)</span>
                            @if (record.PunchInIsCorrected)
                            {
                                <span class="attendance-badge corrected">Corrected</span>
                            }
                        </td>
                        <td>
                            <span class="attendance-punch-time">@FormatUtc(record.PunchOutUtc)</span>
                            @if (record.PunchOutIsCorrected)
                            {
                                <span class="attendance-badge corrected">Corrected</span>
                            }
                        </td>
                        <td class="attendance-hours-cell">@(record.WorkHours?.ToString("0.##") ?? "—")</td>
                        <td><span class="attendance-badge @GetStatusClass(record.Status)">@FormatStatus(record.Status)</span></td>
                        @if (ShowAdminEdit)
                        {
                            <td class="attendance-table-actions">
                                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => OnAdminEdit.InvokeAsync(record)">Set times</button>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter]
    public IReadOnlyList<AttendanceRecordDto> Records { get; set; } = [];

    [Parameter]
    public bool ShowDeveloper { get; set; }

    [Parameter]
    public bool ShowAdminEdit { get; set; }

    [Parameter]
    public string OfficeTimeZoneId { get; set; } = "Asia/Dhaka";

    [Parameter]
    public EventCallback<AttendanceRecordDto> OnAdminEdit { get; set; }

    private string FormatUtc(DateTime? utc)
    {
        if (!utc.HasValue)
        {
            return "—";
        }

        try
        {
            var tz = TimeZoneInfo.FindSystemTimeZoneById(OfficeTimeZoneId);
            return TimeZoneInfo.ConvertTimeFromUtc(utc.Value, tz).ToString("h:mm tt");
        }
        catch
        {
            return utc.Value.ToLocalTime().ToString("h:mm tt");
        }
    }

    private static string FormatStatus(AttendanceDayStatusDto status) => status switch
    {
        AttendanceDayStatusDto.OnTime => "On time",
        AttendanceDayStatusDto.Late => "Late",
        AttendanceDayStatusDto.EarlyLeave => "Early leave",
        AttendanceDayStatusDto.Incomplete => "Incomplete",
        AttendanceDayStatusDto.Absent => "Absent",
        _ => status.ToString()
    };

    private static string GetStatusClass(AttendanceDayStatusDto status) => status switch
    {
        AttendanceDayStatusDto.OnTime => "on-time",
        AttendanceDayStatusDto.Late => "late",
        AttendanceDayStatusDto.EarlyLeave => "early-leave",
        AttendanceDayStatusDto.Incomplete => "incomplete",
        AttendanceDayStatusDto.Absent => "absent",
        _ => string.Empty
    };
}
