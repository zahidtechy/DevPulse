@if (Records.Count == 0)
{
    <div class="attendance-empty-state">
        <div class="attendance-empty-icon" aria-hidden="true"></div>
        <h5>No attendance records</h5>
        <p class="text-muted mb-0">No records found for the selected date range.</p>
    </div>
}
else
{
    <div class="table-responsive card form-card attendance-table-card">
        <table class="table table-hover mb-0 attendance-table">
            <thead>
                <tr>
                    @if (ShowDeveloper)
                    {
                        <th>Developer</th>
                    }
                    <th>Date</th>
                    <th>Punch in</th>
                    <th>Punch out</th>
                    <th>Hours</th>
                    <th>Status</th>
                    @if (ShowAdminEdit)
                    {
                        <th class="attendance-table-actions"></th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var record in Records)
                {
                    <tr>
                        @if (ShowDeveloper)
                        {
                            <td class="attendance-dev-name">@record.DeveloperName</td>
                        }
                        <td class="attendance-date-cell">@record.WorkDate.ToString("MMM d, yyyy")</td>
                        <td>
                            <span class="attendance-punch-time">@AttendanceFormatter.FormatTime(record.PunchInUtc, OfficeTimeZoneId)</span>
                            @if (record.PunchInIsCorrected)
                            {
                                <span class="attendance-badge corrected">Corrected</span>
                            }
                        </td>
                        <td>
                            <span class="attendance-punch-time">@AttendanceFormatter.FormatTime(record.PunchOutUtc, OfficeTimeZoneId)</span>
                            @if (record.PunchOutIsCorrected)
                            {
                                <span class="attendance-badge corrected">Corrected</span>
                            }
                        </td>
                        <td class="attendance-hours-cell">
                            @if (record.PunchInUtc is not null && record.PunchOutUtc is null && IsToday(record.WorkDate))
                            {
                                <LiveWorkDuration PunchInUtc="record.PunchInUtc" PunchOutUtc="record.PunchOutUtc" />
                            }
                            else
                            {
                                @FormatDuration(record)
                            }
                        </td>
                        <td><span class="attendance-badge @AttendanceFormatter.DayStatusClass(record.Status)">@AttendanceFormatter.DayStatusLabel(record.Status)</span></td>
                        @if (ShowAdminEdit)
                        {
                            <td class="attendance-table-actions">
                                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => OnAdminEdit.InvokeAsync(record)">Set times</button>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter]
    public IReadOnlyList<AttendanceRecordDto> Records { get; set; } = [];

    [Parameter]
    public bool ShowDeveloper { get; set; }

    [Parameter]
    public bool ShowAdminEdit { get; set; }

    [Parameter]
    public string OfficeTimeZoneId { get; set; } = "Asia/Dhaka";

    [Parameter]
    public EventCallback<AttendanceRecordDto> OnAdminEdit { get; set; }

    private static string FormatDuration(AttendanceRecordDto record)
    {
        if (!record.PunchInUtc.HasValue || !record.PunchOutUtc.HasValue)
        {
            return "—";
        }

        var duration = record.PunchOutUtc.Value - record.PunchInUtc.Value;
        return duration > TimeSpan.Zero ? WorkDurationFormatter.Format(duration) : "—";
    }

    private bool IsToday(DateOnly workDate)
    {
        try
        {
            var tz = TimeZoneInfo.FindSystemTimeZoneById(OfficeTimeZoneId);
            var localToday = DateOnly.FromDateTime(TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, tz));
            return workDate == localToday;
        }
        catch
        {
            return workDate == DateOnly.FromDateTime(DateTime.Now);
        }
    }

}
