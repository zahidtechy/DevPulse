@implements IAsyncDisposable
@inject IJSRuntime JS

@if (IsVisible)
{
    <div class="delete-confirm-backdrop" @onclick="HandleBackdropClick">
        <div class="delete-confirm-dialog"
             role="alertdialog"
             aria-modal="true"
             aria-labelledby="@_titleId"
             aria-describedby="@_messageId"
             tabindex="-1"
             @ref="_dialogRef"
             @onclick:stopPropagation="true"
             @onkeydown="HandleKeyDown">
            <div class="delete-confirm-icon" aria-hidden="true">
                <span class="bi-exclamation-triangle"></span>
            </div>
            <h2 class="delete-confirm-title" id="@_titleId">@Title</h2>
            <p class="delete-confirm-message" id="@_messageId">@Message</p>
            <div class="delete-confirm-actions">
                <button type="button"
                        class="btn btn-outline-secondary"
                        disabled="@IsBusy"
                        @onclick="CancelAsync">
                    @CancelText
                </button>
                <BusyButton CssClass="btn btn-danger"
                            IsBusy="IsBusy"
                            BusyText="@BusyText"
                            OnClick="ConfirmAsync">
                    @ConfirmText
                </BusyButton>
            </div>
        </div>
    </div>
}

@code {
    private readonly string _titleId = $"delete-confirm-title-{Guid.NewGuid():N}";
    private readonly string _messageId = $"delete-confirm-message-{Guid.NewGuid():N}";
    private ElementReference _dialogRef;
    private IJSObjectReference? _module;
    private bool _wasVisible;
    private bool _focusPending;

    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public EventCallback<bool> IsVisibleChanged { get; set; }

    [Parameter]
    public string Title { get; set; } = "Confirm delete";

    [Parameter]
    public string Message { get; set; } = "This action cannot be undone.";

    [Parameter]
    public string ConfirmText { get; set; } = "Delete";

    [Parameter]
    public string CancelText { get; set; } = "Cancel";

    [Parameter]
    public string BusyText { get; set; } = "Deleting...";

    [Parameter]
    public bool IsBusy { get; set; }

    [Parameter]
    public bool CloseOnBackdropClick { get; set; } = true;

    [Parameter]
    public EventCallback OnConfirm { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    protected override void OnParametersSet()
    {
        if (IsVisible && !_wasVisible)
        {
            _focusPending = true;
        }

        if (!IsVisible)
        {
            _focusPending = false;
        }

        _wasVisible = IsVisible;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/deleteConfirm.js");
        }

        if (_module is null)
        {
            return;
        }

        await _module.InvokeVoidAsync("setScrollLock", IsVisible);

        if (_focusPending && IsVisible)
        {
            _focusPending = false;

            try
            {
                await _dialogRef.FocusAsync();
            }
            catch
            {
                // Focus is optional if the element is not yet focusable.
            }
        }
    }

    private async Task ConfirmAsync()
    {
        if (IsBusy)
        {
            return;
        }

        await OnConfirm.InvokeAsync();
    }

    private async Task CancelAsync()
    {
        if (IsBusy)
        {
            return;
        }

        await HideAsync();
        await OnCancel.InvokeAsync();
    }

    private async Task HandleBackdropClick()
    {
        if (!CloseOnBackdropClick || IsBusy)
        {
            return;
        }

        await CancelAsync();
    }

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape" && !IsBusy)
        {
            await CancelAsync();
        }
    }

    private async Task HideAsync()
    {
        if (!IsVisible)
        {
            return;
        }

        await IsVisibleChanged.InvokeAsync(false);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("setScrollLock", false);
            }
            catch (JSDisconnectedException)
            {
                // Page is unloading.
            }

            await _module.DisposeAsync();
        }
    }
}
