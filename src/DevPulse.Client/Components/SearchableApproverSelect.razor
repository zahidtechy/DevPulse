@implements IAsyncDisposable
@inject IJSRuntime JS

<div @ref="_root" class="searchable-select searchable-select-stretch @CssClass">
    <button type="button"
            class="form-select searchable-select-toggle text-start"
            disabled="@Disabled"
            aria-haspopup="listbox"
            aria-expanded="@_isOpen"
            @onclick="ToggleOpen">
        @SelectedLabel
    </button>
    @if (_isOpen)
    {
        <div class="searchable-select-menu border rounded shadow-sm" @onmousedown:preventDefault="true">
            <input @ref="_searchInput"
                   type="text"
                   class="form-control searchable-select-search"
                   placeholder="@SearchPlaceholder"
                   autocomplete="off"
                   @bind="_searchTerm"
                   @bind:event="oninput"
                   @bind:after="OnSearchChanged"
                   @onkeydown="HandleSearchKeyDown" />
            <ul class="list-unstyled mb-0 searchable-select-options" role="listbox">
                @foreach (var (colleague, index) in FilteredColleagues.Select((c, i) => (c, i)))
                {
                    <li role="option">
                        <button type="button"
                                class="searchable-select-option @(IsActive(index) ? "active" : null)"
                                @onclick="() => SelectColleagueAsync(colleague.Id)">
                            <span class="searchable-select-option-name">@colleague.Name</span>
                            @if (!colleague.HasLogin)
                            {
                                <span class="searchable-select-option-meta">no portal login</span>
                            }
                            else if (!string.IsNullOrWhiteSpace(colleague.Email))
                            {
                                <span class="searchable-select-option-meta">@colleague.Email</span>
                            }
                        </button>
                    </li>
                }
                @if (FilteredColleagues.Count == 0)
                {
                    <li class="px-3 py-2 text-muted small">
                        @(string.IsNullOrWhiteSpace(_searchTerm) ? "No colleagues available" : "No colleagues match")
                    </li>
                }
            </ul>
        </div>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<LeaveColleagueDto> Colleagues { get; set; } = [];
    [Parameter] public Guid SelectedValue { get; set; }
    [Parameter] public EventCallback<Guid> SelectedValueChanged { get; set; }
    [Parameter] public Guid? ExcludeDeveloperId { get; set; }
    [Parameter] public string SearchPlaceholder { get; set; } = "Type a name or email...";
    [Parameter] public string Placeholder { get; set; } = "Select approver...";
    [Parameter] public string CssClass { get; set; } = string.Empty;
    [Parameter] public bool Disabled { get; set; }

    private ElementReference _root;
    private ElementReference _searchInput;
    private IJSObjectReference? _module;
    private DotNetObjectReference<SearchableApproverSelect>? _dotNetRef;
    private bool _isOpen;
    private bool _shouldFocusSearch;
    private bool _outsideClickRegistered;
    private string _searchTerm = string.Empty;
    private int _highlightedIndex;
    private IReadOnlyList<LeaveColleagueDto> _filteredColleagues = [];

    private IReadOnlyList<LeaveColleagueDto> AvailableColleagues =>
        ExcludeDeveloperId is { } excludeId
            ? Colleagues.Where(c => c.Id != excludeId).ToList()
            : Colleagues;

    private IReadOnlyList<LeaveColleagueDto> FilteredColleagues => _filteredColleagues;

    private string SelectedLabel
    {
        get
        {
            if (SelectedValue == Guid.Empty)
            {
                return Placeholder;
            }

            var selected = AvailableColleagues.FirstOrDefault(c => c.Id == SelectedValue);
            return selected is null
                ? Placeholder
                : selected.HasLogin
                    ? selected.Name
                    : $"{selected.Name} (no portal login)";
        }
    }

    protected override void OnParametersSet()
    {
        RefreshFilteredColleagues();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/searchableSelect.js");

        if (_isOpen && _shouldFocusSearch)
        {
            _shouldFocusSearch = false;
            await _searchInput.FocusAsync();
        }

        if (_isOpen && !_outsideClickRegistered)
        {
            _dotNetRef ??= DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("registerOutsideClick", _root, _dotNetRef);
            _outsideClickRegistered = true;
        }
        else if (!_isOpen && _outsideClickRegistered)
        {
            await _module.InvokeVoidAsync("unregisterOutsideClick", _root);
            _outsideClickRegistered = false;
        }
    }

    private bool IsActive(int index) => index == _highlightedIndex;

    private void RefreshFilteredColleagues()
    {
        var source = AvailableColleagues;
        if (string.IsNullOrWhiteSpace(_searchTerm))
        {
            _filteredColleagues = source;
        }
        else
        {
            _filteredColleagues = source
                .Where(c =>
                    c.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)
                    || (c.Email?.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ?? false))
                .ToList();
        }

        if (_filteredColleagues.Count == 0)
        {
            _highlightedIndex = -1;
        }
        else
        {
            _highlightedIndex = Math.Clamp(_highlightedIndex, 0, _filteredColleagues.Count - 1);
        }
    }

    private void OnSearchChanged()
    {
        _highlightedIndex = 0;
        RefreshFilteredColleagues();
    }

    private void ToggleOpen()
    {
        if (Disabled)
        {
            return;
        }

        if (_isOpen)
        {
            Close();
            return;
        }

        _isOpen = true;
        _searchTerm = string.Empty;
        _shouldFocusSearch = true;
        RefreshFilteredColleagues();
        var selectedIndex = -1;
        for (var i = 0; i < _filteredColleagues.Count; i++)
        {
            if (_filteredColleagues[i].Id == SelectedValue)
            {
                selectedIndex = i;
                break;
            }
        }

        _highlightedIndex = selectedIndex >= 0 ? selectedIndex : 0;
    }

    private void Close()
    {
        _isOpen = false;
        _searchTerm = string.Empty;
        _highlightedIndex = 0;
        RefreshFilteredColleagues();
    }

    [JSInvokable]
    public Task CloseFromOutside()
    {
        if (!_isOpen)
        {
            return Task.CompletedTask;
        }

        Close();
        return InvokeAsync(StateHasChanged);
    }

    private async Task SelectColleagueAsync(Guid colleagueId)
    {
        Close();
        await SelectedValueChanged.InvokeAsync(colleagueId);
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "Escape":
                Close();
                break;
            case "ArrowDown":
                if (FilteredColleagues.Count > 0)
                {
                    _highlightedIndex = Math.Min(_highlightedIndex + 1, FilteredColleagues.Count - 1);
                }
                break;
            case "ArrowUp":
                if (FilteredColleagues.Count > 0)
                {
                    _highlightedIndex = Math.Max(_highlightedIndex - 1, 0);
                }
                break;
            case "Enter":
                if (_highlightedIndex >= 0 && _highlightedIndex < FilteredColleagues.Count)
                {
                    await SelectColleagueAsync(FilteredColleagues[_highlightedIndex].Id);
                }
                break;
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module is not null && _outsideClickRegistered)
            {
                await _module.InvokeVoidAsync("unregisterOutsideClick", _root);
            }

            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }
        finally
        {
            _dotNetRef?.Dispose();
        }
    }
}
