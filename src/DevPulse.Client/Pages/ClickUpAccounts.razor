@page "/clickup-accounts"
@attribute [Authorize(Roles = AppRoles.Admin)]
@inject IClickUpAccountApiClient AccountApi

<PageTitle>@AppBranding.PageTitle("ClickUp Accounts")</PageTitle>

<div class="clickup-accounts-page">
    <div class="analytics-hero analytics-hero-compact clickup-accounts-hero">
        <div class="analytics-hero-copy">
            <p class="analytics-eyebrow">Admin · Integrations</p>
            <h1>ClickUp Workspaces</h1>
            <p class="analytics-lead">
                Connect API tokens, validate workspace access, and browse members for developer mapping.
            </p>
        </div>
        <div class="analytics-hero-actions">
            <button class="btn btn-light btn-sm" @onclick="ShowAddForm">
                <span class="bi-plug clickup-accounts-btn-icon" aria-hidden="true"></span>
                Add Account
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert @(_isError ? "alert-danger" : "alert-success") leave-alert" role="alert">@_message</div>
    }

    @if (_isBusy && !_isLoading)
    {
        <LoadingIndicator Text="Processing..." />
    }

    @if (_showAddForm)
    {
        <div class="filter-card card mb-4 clickup-accounts-form-card">
            <div class="card-body">
                <div class="filter-section-header mb-1">
                    <span class="filter-section-label">Connect ClickUp Workspace</span>
                </div>
                <p class="text-muted small mb-3">
                    Paste your personal API token and workspace ID. The connection is validated before saving.
                </p>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Account name</label>
                        <input class="form-control" @bind="_newAccount.Name" placeholder="Client A Production" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Workspace ID</label>
                        <input class="form-control" @bind="_newAccount.WorkspaceId" placeholder="9012345678" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Access token</label>
                        <input type="password" class="form-control" @bind="_newAccount.AccessToken" placeholder="pk_..." autocomplete="off" />
                    </div>
                </div>
                <div class="filter-actions mt-3">
                    <button class="btn btn-outline-secondary" disabled="@_isBusy" @onclick="HideAddForm">Cancel</button>
                    <BusyButton CssClass="btn btn-primary" IsBusy="_isBusy" BusyText="Validating..." OnClick="CreateAccountAsync">
                        Save &amp; Validate
                    </BusyButton>
                </div>
            </div>
        </div>
    }

    @if (_isLoading)
    {
        <LoadingIndicator Text="Loading accounts..." />
    }
    else if (_accounts.Count == 0)
    {
        <div class="clickup-accounts-empty-state">
            <div class="clickup-accounts-empty-icon" aria-hidden="true">
                <span class="bi-plug"></span>
            </div>
            <h3>No ClickUp accounts configured</h3>
            <p>Add your first workspace token to sync developers and build unified reports.</p>
            <div class="clickup-accounts-empty-actions">
                <button class="btn btn-primary" @onclick="ShowAddForm">Add Account</button>
            </div>
        </div>
    }
    else
    {
        <div class="clickup-accounts-stats">
            <div class="clickup-accounts-stat-card">
                <span class="clickup-accounts-stat-label">Total</span>
                <span class="clickup-accounts-stat-value">@_accounts.Count</span>
            </div>
            <div class="clickup-accounts-stat-card">
                <span class="clickup-accounts-stat-label">Active</span>
                <span class="clickup-accounts-stat-value clickup-accounts-stat-value-success">@GetActiveCount()</span>
            </div>
            <div class="clickup-accounts-stat-card">
                <span class="clickup-accounts-stat-label">Validated</span>
                <span class="clickup-accounts-stat-value clickup-accounts-stat-value-info">@GetValidatedCount()</span>
            </div>
            <div class="clickup-accounts-stat-card">
                <span class="clickup-accounts-stat-label">Inactive</span>
                <span class="clickup-accounts-stat-value">@GetInactiveCount()</span>
            </div>
        </div>

        <div class="filter-card card mb-4 clickup-accounts-toolbar">
            <div class="card-body">
                <div class="row g-2 align-items-end">
                    <div class="col-md-4 col-lg-3">
                        <label class="form-label mb-1" for="accountSearch">Search</label>
                        <div class="clickup-accounts-search-wrap">
                            <span class="bi-search clickup-accounts-search-icon" aria-hidden="true"></span>
                            <input id="accountSearch"
                                   type="search"
                                   class="form-control form-control-sm clickup-accounts-search-input"
                                   placeholder="Name or workspace ID..."
                                   @bind="_accountSearch"
                                   @bind:event="oninput" />
                        </div>
                    </div>
                    <div class="col-md-3 col-lg-2">
                        <label class="form-label mb-1" for="accountStatusFilter">Status</label>
                        <select id="accountStatusFilter" class="form-select form-select-sm" @bind="_statusFilter">
                            <option value="all">All statuses</option>
                            <option value="active">Active</option>
                            <option value="inactive">Inactive</option>
                        </select>
                    </div>
                    <div class="col-md-5 col-lg-7 d-flex align-items-end justify-content-lg-end">
                        <div class="clickup-accounts-filter-meta">
                            <span class="filter-count-badge">
                                @FilteredAccounts.Count() account@(FilteredAccounts.Count() == 1 ? "" : "s")
                            </span>
                            @if (HasActiveFilters)
                            {
                                <button type="button" class="btn btn-link btn-sm clickup-accounts-clear-filters" @onclick="ClearFilters">Clear filters</button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="data-card card clickup-accounts-table-card">
            <div class="card-body p-0">
                @if (!FilteredAccounts.Any())
                {
                    <div class="clickup-accounts-filter-empty">
                        <span class="bi-funnel clickup-accounts-filter-empty-icon" aria-hidden="true"></span>
                        <h5>No accounts match your filters</h5>
                        <p class="text-muted mb-3">Try a different search term or status.</p>
                        @if (HasActiveFilters)
                        {
                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ClearFilters">Clear filters</button>
                        }
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 clickup-accounts-table">
                            <thead>
                                <tr>
                                    <th>Workspace</th>
                                    <th>Workspace ID</th>
                                    <th>Status</th>
                                    <th>Last validated</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var account in FilteredAccounts)
                                {
                                    <tr class="@(account.IsActive ? null : "clickup-accounts-row-inactive")">
                                        <td>
                                            <div class="clickup-accounts-workspace">
                                                <span class="clickup-accounts-avatar @(account.IsActive ? "clickup-accounts-avatar-active" : "clickup-accounts-avatar-inactive")" aria-hidden="true">
                                                    @GetInitials(account.Name)
                                                </span>
                                                <div class="clickup-accounts-workspace-meta">
                                                    <span class="clickup-accounts-workspace-name">@account.Name</span>
                                                    <span class="clickup-accounts-workspace-added">Added @account.CreatedAtUtc.ToLocalTime().ToString("MMM d, yyyy")</span>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <code class="clickup-accounts-workspace-id">@account.WorkspaceId</code>
                                        </td>
                                        <td>
                                            <span class="clickup-accounts-status @(account.IsActive ? "clickup-accounts-status-active" : "clickup-accounts-status-inactive")">
                                                <span class="status-dot @(account.IsActive ? "status-dot-active" : "status-dot-inactive")" aria-hidden="true"></span>
                                                @(account.IsActive ? "Active" : "Inactive")
                                            </span>
                                        </td>
                                        <td>
                                            @if (account.LastValidatedAtUtc.HasValue)
                                            {
                                                <div class="clickup-accounts-validation">
                                                    <span class="clickup-accounts-validation-date">@account.LastValidatedAtUtc.Value.ToLocalTime().ToString("g")</span>
                                                    @if (!string.IsNullOrWhiteSpace(account.LastValidationMessage))
                                                    {
                                                        <span class="clickup-accounts-validation-message @GetValidationMessageClass(account.LastValidationMessage)">
                                                            @account.LastValidationMessage
                                                        </span>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="clickup-accounts-not-validated">Not validated yet</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <div class="btn-group-actions">
                                                <button class="btn btn-sm btn-outline-primary" disabled="@_isBusy" @onclick="() => TestAccountAsync(account.Id)" title="Test API connection">
                                                    <span class="bi-lightning-charge" aria-hidden="true"></span>
                                                    Test
                                                </button>
                                                <button class="btn btn-sm btn-outline-secondary @(_membersAccountId == account.Id ? "active" : null)"
                                                        disabled="@_isBusy"
                                                        @onclick="() => LoadMembersAsync(account)"
                                                        title="View workspace members">
                                                    <span class="bi-people" aria-hidden="true"></span>
                                                    Members
                                                </button>
                                                @if (account.IsActive)
                                                {
                                                    <button class="btn btn-sm btn-outline-secondary" disabled="@_isBusy" @onclick="() => SetAccountActiveAsync(account, false)" title="Mark inactive without affecting reports or analytics">
                                                        Deactivate
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-sm btn-outline-success" disabled="@_isBusy" @onclick="() => SetAccountActiveAsync(account, true)">
                                                        Activate
                                                    </button>
                                                }
                                                <button class="btn btn-sm btn-outline-danger" disabled="@_isBusy" @onclick="() => DeleteAccountAsync(account.Id)" title="Delete account">
                                                    <span class="bi-trash" aria-hidden="true"></span>
                                                    Delete
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }

    @if (_members.Count > 0 && !string.IsNullOrWhiteSpace(_membersAccountName))
    {
        <div class="filter-card card mt-4 clickup-accounts-members-card">
            <div class="card-body">
                <div class="clickup-accounts-members-header">
                    <div>
                        <span class="filter-section-label">Workspace members</span>
                        <h5 class="clickup-accounts-members-title">@_membersAccountName</h5>
                        <p class="text-muted small mb-0">@_members.Count member@(_members.Count == 1 ? "" : "s") loaded from ClickUp</p>
                    </div>
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ClearMembers">Close</button>
                </div>
                <div class="table-responsive mt-3">
                    <table class="table table-hover align-middle mb-0 clickup-accounts-members-table">
                        <thead>
                            <tr>
                                <th>Member</th>
                                <th>User ID</th>
                                <th>Email</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var member in _members)
                            {
                                <tr>
                                    <td>
                                        <div class="clickup-accounts-member">
                                            <span class="clickup-accounts-member-avatar" aria-hidden="true">@GetInitials(member.Username)</span>
                                            <span class="clickup-accounts-member-name">@member.Username</span>
                                        </div>
                                    </td>
                                    <td><code class="clickup-accounts-member-id">@member.ClickUpUserId</code></td>
                                    <td>@(string.IsNullOrWhiteSpace(member.Email) ? "—" : member.Email)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private readonly List<ClickUpAccountDto> _accounts = [];
    private readonly List<ClickUpMemberDto> _members = [];
    private CreateClickUpAccountFormModel _newAccount = new();
    private string _accountSearch = string.Empty;
    private string _statusFilter = "all";
    private Guid? _membersAccountId;
    private string? _membersAccountName;
    private bool _showAddForm;
    private bool _isLoading = true;
    private bool _isBusy;
    private bool _isError;
    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        await LoadAccountsAsync();
    }

    private IEnumerable<ClickUpAccountDto> FilteredAccounts =>
        _accounts.Where(account =>
        {
            if (!string.Equals(_statusFilter, "all", StringComparison.OrdinalIgnoreCase))
            {
                var isActiveFilter = string.Equals(_statusFilter, "active", StringComparison.OrdinalIgnoreCase);
                if (account.IsActive != isActiveFilter)
                {
                    return false;
                }
            }

            if (string.IsNullOrWhiteSpace(_accountSearch))
            {
                return true;
            }

            var search = _accountSearch.Trim();
            return account.Name.Contains(search, StringComparison.OrdinalIgnoreCase)
                || account.WorkspaceId.Contains(search, StringComparison.OrdinalIgnoreCase);
        });

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(_accountSearch)
        || !string.Equals(_statusFilter, "all", StringComparison.OrdinalIgnoreCase);

    private void ClearFilters()
    {
        _accountSearch = string.Empty;
        _statusFilter = "all";
    }

    private async Task LoadAccountsAsync()
    {
        _isLoading = true;
        _message = null;

        try
        {
            var accounts = await AccountApi.GetAccountsAsync();
            _accounts.Clear();
            _accounts.AddRange(accounts.OrderBy(a => a.Name));
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = $"Failed to load accounts: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ShowAddForm()
    {
        _showAddForm = true;
        _newAccount = new CreateClickUpAccountFormModel();
        _message = null;
    }

    private void HideAddForm()
    {
        _showAddForm = false;
    }

    private void ClearMembers()
    {
        _members.Clear();
        _membersAccountId = null;
        _membersAccountName = null;
    }

    private async Task CreateAccountAsync()
    {
        _isBusy = true;
        _message = null;

        try
        {
            await AccountApi.CreateAccountAsync(_newAccount.ToRequest());
            _showAddForm = false;
            _isError = false;
            _message = "ClickUp account created and validated successfully.";
            await LoadAccountsAsync();
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task TestAccountAsync(Guid accountId)
    {
        _isBusy = true;
        _message = null;

        try
        {
            var result = await AccountApi.TestConnectionAsync(accountId);
            _isError = result is null || !result.IsConnected;
            _message = result?.Message ?? "Connection test failed.";
            await LoadAccountsAsync();
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task LoadMembersAsync(ClickUpAccountDto account)
    {
        if (_membersAccountId == account.Id && _members.Count > 0)
        {
            ClearMembers();
            return;
        }

        _isBusy = true;
        _message = null;

        try
        {
            var members = await AccountApi.GetMembersAsync(account.Id);
            _members.Clear();
            _members.AddRange(members.OrderBy(m => m.Username));
            _membersAccountId = account.Id;
            _membersAccountName = account.Name;
            _isError = false;
            _message = $"Loaded {members.Count} workspace members for {account.Name}.";
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task SetAccountActiveAsync(ClickUpAccountDto account, bool isActive)
    {
        _isBusy = true;
        _message = null;

        try
        {
            await AccountApi.UpdateAccountStatusAsync(account.Id, isActive);
            _isError = false;
            _message = isActive
                ? $"{account.Name} marked active."
                : $"{account.Name} marked inactive. Reports and analytics are unchanged.";
            await LoadAccountsAsync();
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task DeleteAccountAsync(Guid accountId)
    {
        _isBusy = true;
        _message = null;

        try
        {
            await AccountApi.DeleteAccountAsync(accountId);
            _isError = false;
            _message = "Account deleted.";
            if (_membersAccountId == accountId)
            {
                ClearMembers();
            }

            await LoadAccountsAsync();
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private int GetActiveCount() => _accounts.Count(a => a.IsActive);

    private int GetInactiveCount() => _accounts.Count(a => !a.IsActive);

    private int GetValidatedCount() => _accounts.Count(a => a.LastValidatedAtUtc.HasValue);

    private static string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "?";
        }

        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return parts.Length >= 2
            ? $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[1][0])}"
            : char.ToUpperInvariant(parts[0][0]).ToString();
    }

    private static string GetValidationMessageClass(string message) =>
        message.Contains("success", StringComparison.OrdinalIgnoreCase)
        || message.Contains("connected", StringComparison.OrdinalIgnoreCase)
            ? "clickup-accounts-validation-ok"
            : "clickup-accounts-validation-warn";
}
