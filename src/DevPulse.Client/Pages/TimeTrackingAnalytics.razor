@page "/time-analytics"
@attribute [Authorize(Policy = "CanViewReports")]
@inject IHubstaffOrganizationApiClient HubstaffOrgApi
@inject IHubstaffSyncApiClient HubstaffSyncApi
@inject IHubstaffAnalyticsApiClient HubstaffAnalyticsApi
@inject IDeveloperApiClient DeveloperApi

<PageTitle>@AppBranding.PageTitle("Time Tracking Analytics")</PageTitle>

<div class="analytics-page">
    <div class="analytics-hero analytics-hero-compact analytics-page-hero">
        <div class="analytics-hero-copy">
            <p class="analytics-eyebrow">Hubstaff · Tracked Hours</p>
            <h1>Time Tracking Analytics</h1>
            <p class="analytics-lead">View synced Hubstaff daily hours from the local database.</p>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert @(_isInfoMessage ? "alert-info" : "alert-danger") leave-alert" role="alert">@_error</div>
    }

    @if (ShowSetupHint())
    {
        <div class="alert alert-info leave-alert" role="status">
            Hubstaff is connected. To see analytics: (1) go to <a href="/developers">Developers</a> and click <strong>Sync from Hubstaff</strong> to map team members,
            (2) click <strong>Sync now</strong> below to pull tracked hours, then (3) click <strong>Generate</strong>.
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_syncMessage))
    {
        <div class="alert alert-success leave-alert" role="status">@_syncMessage</div>
    }

    @if (_syncStatus?.LatestRun is not null)
    {
        <div class="filter-card card mb-3">
            <div class="card-body py-2">
                <small class="text-muted">
                    Last sync: @_syncStatus.LatestRun.StartedAtUtc.ToString("u") —
                    @_syncStatus.LatestRun.Status
                    (@_syncStatus.LatestRun.ActivitiesUpserted upserted)
                </small>
            </div>
        </div>
    }

    <div class="filter-card card analytics-toolbar mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label">Hubstaff organization</label>
                    <select class="form-select" @bind="_selectedOrgId">
                        <option value="">Select...</option>
                        @foreach (var org in _organizations.Where(o => o.IsActive))
                        {
                            <option value="@org.Id">@org.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">From</label>
                    <input type="date" class="form-control" @bind="_fromDate" @bind:format="yyyy-MM-dd" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">To</label>
                    <input type="date" class="form-control" @bind="_toDate" @bind:format="yyyy-MM-dd" />
                </div>
                <div class="col-md-5 d-flex gap-2">
                    <BusyButton CssClass="btn btn-primary" IsBusy="_isLoading" BusyText="Loading..." OnClick="LoadAnalyticsAsync">
                        Generate
                    </BusyButton>
                    <AuthorizeView Roles="@AppRoles.Admin">
                        <Authorized>
                            <BusyButton CssClass="btn btn-outline-secondary" IsBusy="_isSyncing" BusyText="Syncing..." OnClick="RunSyncAsync">
                                Sync now
                            </BusyButton>
                        </Authorized>
                    </AuthorizeView>
                </div>
            </div>
        </div>
    </div>

    @if (_analytics is not null)
    {
        @if (_analytics.IsStale)
        {
            <div class="alert alert-warning leave-alert">Synced data is older than 48 hours. Consider running a sync.</div>
        }

        <div class="analytics-kpi-grid mb-4">
            <div class="analytics-kpi-card">
                <span class="analytics-kpi-label">Total tracked</span>
                <span class="analytics-kpi-value">@_analytics.Summary.TotalTrackedHours h</span>
            </div>
            <div class="analytics-kpi-card">
                <span class="analytics-kpi-label">Billable ratio</span>
                <span class="analytics-kpi-value">@($"{_analytics.Summary.BillableRatio:P1}")</span>
            </div>
            <div class="analytics-kpi-card">
                <span class="analytics-kpi-label">Idle ratio</span>
                <span class="analytics-kpi-value">@($"{_analytics.Summary.IdleRatio:P1}")</span>
            </div>
            <div class="analytics-kpi-card">
                <span class="analytics-kpi-label">Avg h/dev/day</span>
                <span class="analytics-kpi-value">@_analytics.Summary.AverageHoursPerDeveloperPerDay</span>
            </div>
        </div>

        <div class="data-card card">
            <div class="card-header">Hours by developer</div>
            <div class="card-body p-0">
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th>Developer</th>
                            <th>Tracked</th>
                            <th>Billable</th>
                            <th>Idle</th>
                            <th>Manual</th>
                            <th>Active days</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var dev in _analytics.ByDeveloper)
                        {
                            <tr>
                                <td>@dev.Name</td>
                                <td>@dev.TrackedHours</td>
                                <td>@dev.BillableHours</td>
                                <td>@dev.IdleHours</td>
                                <td>@dev.ManualHours</td>
                                <td>@dev.ActiveDays</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private readonly List<HubstaffOrganizationDto> _organizations = [];
    private HubstaffAnalyticsResponse? _analytics;
    private HubstaffSyncStatusDto? _syncStatus;
    private string _selectedOrgId = string.Empty;
    private DateTime _fromDate = DateTime.Today.AddDays(-29);
    private DateTime _toDate = DateTime.Today;
    private bool _isLoading;
    private bool _isSyncing;
    private string? _error;
    private bool _isInfoMessage;
    private string? _syncMessage;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadOrganizationsAsync(), LoadSyncStatusAsync());
        ApplyThisMonthPreset();
    }

    private void ApplyThisMonthPreset()
    {
        _fromDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        _toDate = DateTime.Today;
    }

    private async Task LoadOrganizationsAsync()
    {
        try
        {
            var items = await HubstaffOrgApi.GetOrganizationsAsync();
            _organizations.Clear();
            _organizations.AddRange(items);
            if (_organizations.Count == 1)
            {
                _selectedOrgId = _organizations[0].Id.ToString();
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task LoadSyncStatusAsync()
    {
        try
        {
            _syncStatus = await HubstaffSyncApi.GetStatusAsync();
        }
        catch
        {
            // Non-fatal for page load.
        }
    }

    private async Task LoadAnalyticsAsync()
    {
        if (!Guid.TryParse(_selectedOrgId, out var orgId))
        {
            _error = "Select a Hubstaff organization.";
            return;
        }

        _isLoading = true;
        _error = null;
        _isInfoMessage = false;
        try
        {
            var request = new HubstaffAnalyticsRequest(
                orgId,
                DateOnly.FromDateTime(_fromDate),
                DateOnly.FromDateTime(_toDate),
                null,
                false);

            _analytics = await HubstaffAnalyticsApi.GetAnalyticsAsync(request);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _isInfoMessage = IsAnalyticsInfoMessage(ex.Message);
            _analytics = null;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RunSyncAsync()
    {
        if (!Guid.TryParse(_selectedOrgId, out var orgId))
        {
            _error = "Select a Hubstaff organization before syncing.";
            return;
        }

        _isSyncing = true;
        _syncMessage = null;
        _error = null;
        _isInfoMessage = false;
        try
        {
            var request = new HubstaffSyncTriggerRequest(
                orgId,
                DateOnly.FromDateTime(_fromDate),
                DateOnly.FromDateTime(_toDate));

            var result = await HubstaffSyncApi.TriggerSyncAsync(request);
            _syncMessage = result?.Message ?? "Sync completed.";
            await LoadSyncStatusAsync();
            await LoadOrganizationsAsync();
            await LoadAnalyticsAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isSyncing = false;
        }
    }

    private bool ShowSetupHint()
    {
        if (!Guid.TryParse(_selectedOrgId, out var orgId))
        {
            return false;
        }

        var org = _organizations.FirstOrDefault(o => o.Id == orgId);
        return org is { LastSyncedToDate: null };
    }

    private static bool IsAnalyticsInfoMessage(string message) =>
        message.Contains("No synced Hubstaff activity", StringComparison.OrdinalIgnoreCase)
        || message.Contains("Hubstaff is connected but activity has not been synced", StringComparison.OrdinalIgnoreCase)
        || message.Contains("Synced Hubstaff activity exists for this period, but no developers are mapped", StringComparison.OrdinalIgnoreCase);
}
