@page "/users"
@attribute [Authorize(Roles = AppRoles.Admin)]
@inject IUserApiClient UserApi
@inject IDeveloperApiClient DeveloperApi

<PageTitle>@AppBranding.PageTitle("User Management")</PageTitle>

<div class="users-page">
    <div class="analytics-hero analytics-hero-compact users-hero">
        <div class="analytics-hero-copy">
            <p class="analytics-eyebrow">Admin · Access</p>
            <h1>User Management</h1>
            <p class="analytics-lead">
                Create application accounts, assign roles, reset passwords, and link users to developer profiles.
            </p>
        </div>
        <div class="analytics-hero-actions">
            <button class="btn btn-light btn-sm" @onclick="ShowAddForm">
                <span class="bi-person-plus users-btn-icon" aria-hidden="true"></span>
                Add User
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert @(_isError ? "alert-danger" : "alert-success") leave-alert" role="alert">@_message</div>
    }

    @if (_isBusy && !_isLoading)
    {
        <LoadingIndicator Text="Processing..." />
    }

    @if (_resetPasswordUserId.HasValue)
    {
        <div class="filter-card card mb-4 users-form-card">
            <div class="card-body">
                <div class="filter-section-header mb-1">
                    <span class="filter-section-label">Reset password</span>
                </div>
                <p class="text-muted small mb-3">
                    Set a new password for <strong>@_resetPasswordDisplayName</strong> (@_resetPasswordEmail).
                </p>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">New password</label>
                        <input type="password" class="form-control" @bind="_resetPassword" autocomplete="new-password" />
                        <div class="form-text">At least 8 characters with uppercase, lowercase, digit, and special character.</div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Confirm password</label>
                        <input type="password" class="form-control" @bind="_resetPasswordConfirm" autocomplete="new-password" />
                    </div>
                </div>
                <div class="filter-actions mt-3">
                    <button class="btn btn-outline-secondary" disabled="@_isBusy" @onclick="HideResetPasswordForm">Cancel</button>
                    <BusyButton CssClass="btn btn-warning" IsBusy="_isBusy" BusyText="Resetting..." OnClick="ResetPasswordAsync">
                        Reset Password
                    </BusyButton>
                </div>
            </div>
        </div>
    }

    @if (_showAddForm)
    {
        <div class="filter-card card mb-4 users-form-card">
            <div class="card-body">
                <div class="filter-section-header mb-3">
                    <span class="filter-section-label">@(_editingUserId.HasValue ? "Edit User" : "New User")</span>
                </div>
                <div class="row g-3">
                    @if (!_editingUserId.HasValue)
                    {
                        <div class="col-md-4">
                            <label class="form-label">Email</label>
                            <input type="email" class="form-control" @bind="_newUser.Email" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Password</label>
                            <input type="password" class="form-control" @bind="_newUser.Password" autocomplete="new-password" />
                            <div class="form-text">At least 8 characters with uppercase, lowercase, digit, and special character.</div>
                        </div>
                    }
                    <div class="col-md-4">
                        <label class="form-label">Display name</label>
                        <input class="form-control" @bind="_newUser.DisplayName" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Role</label>
                        <select class="form-select" @bind="_newUser.Role">
                            @foreach (var role in AppRoles.All)
                            {
                                <option value="@role">@role</option>
                            }
                        </select>
                    </div>
                    @if (_editingUserId.HasValue)
                    {
                        <div class="col-md-4 d-flex align-items-end">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="userActive" @bind="_editIsActive" />
                                <label class="form-check-label" for="userActive">Active</label>
                            </div>
                        </div>
                    }
                </div>

                <div class="users-form-divider mt-4 pt-3">
                    <span class="filter-section-label">Developer profile</span>
                    <p class="text-muted small mb-3 mt-1">
                        Link this user to a developer record for leave and attendance. Pick an existing developer or create a new one when adding a user.
                    </p>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label" for="developerLink">Link to developer</label>
                            <div class="users-search-wrap mb-2">
                                <span class="bi-search users-search-icon" aria-hidden="true"></span>
                                <input id="developerSearch"
                                       class="form-control form-control-sm users-search-input"
                                       placeholder="Filter by name or email..."
                                       @bind="_developerSearch"
                                       @bind:event="oninput"
                                       disabled="@(_createDeveloper && !_editingUserId.HasValue)" />
                            </div>
                            <select id="developerLink"
                                    class="form-select"
                                    @bind="_selectedDeveloperId"
                                    disabled="@(_createDeveloper && !_editingUserId.HasValue)">
                                <option value="">No link (match by email only)</option>
                                @foreach (var developer in FilteredDevelopers)
                                {
                                    <option value="@developer.Id">
                                        @developer.Name@(string.IsNullOrWhiteSpace(developer.Email) ? "" : $" ({developer.Email})")
                                    </option>
                                }
                            </select>
                        </div>
                        @if (!_editingUserId.HasValue)
                        {
                            <div class="col-md-6 d-flex align-items-end">
                                <div class="form-check">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           id="createDeveloper"
                                           @bind="_createDeveloper"
                                           @bind:after="OnCreateDeveloperChanged" />
                                    <label class="form-check-label" for="createDeveloper">
                                        Also create a new developer profile
                                    </label>
                                    <div class="form-text">
                                        Creates a developer with the same email and display name. Cannot be combined with linking an existing developer.
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="filter-actions mt-3">
                    <button class="btn btn-outline-secondary" disabled="@_isBusy" @onclick="HideForm">Cancel</button>
                    <BusyButton CssClass="btn btn-primary" IsBusy="_isBusy" BusyText="Saving..." OnClick="SaveUserAsync">
                        @(_editingUserId.HasValue ? "Update User" : "Create User")
                    </BusyButton>
                </div>
            </div>
        </div>
    }

    @if (_isLoading)
    {
        <LoadingIndicator Text="Loading users..." />
    }
    else if (_users.Count == 0)
    {
        <div class="users-empty-state">
            <div class="users-empty-icon" aria-hidden="true">
                <span class="bi-people"></span>
            </div>
            <h3>No users yet</h3>
            <p>Create the first application account to give your team access to DevPulse.</p>
            <div class="users-empty-actions">
                <button class="btn btn-primary" @onclick="ShowAddForm">Add User</button>
            </div>
        </div>
    }
    else
    {
        <div class="users-stats">
            <div class="users-stat-card">
                <span class="users-stat-label">Total</span>
                <span class="users-stat-value">@_users.Count</span>
            </div>
            <div class="users-stat-card">
                <span class="users-stat-label">Active</span>
                <span class="users-stat-value users-stat-value-success">@GetActiveCount()</span>
            </div>
            <div class="users-stat-card">
                <span class="users-stat-label">Admins</span>
                <span class="users-stat-value users-stat-value-info">@GetAdminCount()</span>
            </div>
            <div class="users-stat-card">
                <span class="users-stat-label">Linked</span>
                <span class="users-stat-value">@GetLinkedDeveloperCount()</span>
            </div>
        </div>

        <div class="filter-card card mb-4 users-toolbar">
            <div class="card-body">
                <div class="row g-2 align-items-end">
                    <div class="col-md-4 col-lg-3">
                        <label class="form-label mb-1" for="userSearch">Search</label>
                        <div class="users-search-wrap">
                            <span class="bi-search users-search-icon" aria-hidden="true"></span>
                            <input id="userSearch"
                                   type="search"
                                   class="form-control form-control-sm users-search-input"
                                   placeholder="Name or email..."
                                   @bind="_userSearch"
                                   @bind:event="oninput" />
                        </div>
                    </div>
                    <div class="col-md-3 col-lg-2">
                        <label class="form-label mb-1" for="userRoleFilter">Role</label>
                        <select id="userRoleFilter" class="form-select form-select-sm" @bind="_roleFilter">
                            <option value="all">All roles</option>
                            <option value="@AppRoles.Admin">Admin</option>
                            <option value="@AppRoles.User">User</option>
                        </select>
                    </div>
                    <div class="col-md-3 col-lg-2">
                        <label class="form-label mb-1" for="userStatusFilter">Status</label>
                        <select id="userStatusFilter" class="form-select form-select-sm" @bind="_statusFilter">
                            <option value="all">All statuses</option>
                            <option value="active">Active</option>
                            <option value="inactive">Inactive</option>
                        </select>
                    </div>
                    <div class="col-md-5 col-lg-5 d-flex align-items-end justify-content-lg-end">
                        <div class="users-filter-meta">
                            <span class="filter-count-badge">
                                @FilteredUsers.Count() user@(FilteredUsers.Count() == 1 ? "" : "s")
                            </span>
                            @if (HasActiveFilters)
                            {
                                <button type="button" class="btn btn-link btn-sm users-clear-filters" @onclick="ClearFilters">Clear filters</button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="data-card card users-table-card">
            <div class="card-body p-0">
                @if (!FilteredUsers.Any())
                {
                    <div class="users-filter-empty">
                        <span class="bi-funnel users-filter-empty-icon" aria-hidden="true"></span>
                        <h5>No users match your filters</h5>
                        <p class="text-muted mb-3">Try a different search term, role, or status.</p>
                        @if (HasActiveFilters)
                        {
                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ClearFilters">Clear filters</button>
                        }
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 users-table">
                            <thead>
                                <tr>
                                    <th>User</th>
                                    <th>Linked developer</th>
                                    <th>Role</th>
                                    <th>Status</th>
                                    <th>Created</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var user in FilteredUsers)
                                {
                                    <tr class="@(user.IsActive ? null : "users-row-inactive")">
                                        <td>
                                            <div class="users-person">
                                                <span class="users-avatar @GetRoleAvatarClass(user.Role)" aria-hidden="true">
                                                    @GetInitials(user.DisplayName)
                                                </span>
                                                <div class="users-person-meta">
                                                    <span class="users-person-name">@user.DisplayName</span>
                                                    <span class="users-person-email">@user.Email</span>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(user.DeveloperName))
                                            {
                                                <span class="users-developer-link">
                                                    <span class="bi-link-45deg" aria-hidden="true"></span>
                                                    @user.DeveloperName
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="users-unlinked">Not linked</span>
                                            }
                                        </td>
                                        <td>
                                            <span class="users-role-badge @GetRoleBadgeClass(user.Role)">@user.Role</span>
                                        </td>
                                        <td>
                                            <span class="users-status @(user.IsActive ? "users-status-active" : "users-status-inactive")">
                                                <span class="status-dot @(user.IsActive ? "status-dot-active" : "status-dot-inactive")" aria-hidden="true"></span>
                                                @(user.IsActive ? "Active" : "Inactive")
                                            </span>
                                        </td>
                                        <td>
                                            <span class="users-created">@user.CreatedAtUtc.ToLocalTime().ToString("MMM d, yyyy")</span>
                                        </td>
                                        <td class="text-end">
                                            <div class="btn-group-actions">
                                                <button class="btn btn-sm btn-outline-primary" disabled="@_isBusy" @onclick="() => EditUser(user)" title="Edit user">
                                                    <span class="bi-pencil" aria-hidden="true"></span>
                                                    Edit
                                                </button>
                                                <button class="btn btn-sm btn-outline-warning" disabled="@_isBusy" @onclick="() => ShowResetPasswordForm(user)" title="Reset password">
                                                    <span class="bi-key" aria-hidden="true"></span>
                                                    Reset
                                                </button>
                                                <button class="btn btn-sm btn-outline-danger" disabled="@_isBusy" @onclick="() => DeleteUserAsync(user.Id)" title="Delete user">
                                                    <span class="bi-trash" aria-hidden="true"></span>
                                                    Delete
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private readonly List<UserDto> _users = [];
    private readonly List<DeveloperDto> _developers = [];
    private readonly UserFormModel _newUser = new();
    private string _userSearch = string.Empty;
    private string _statusFilter = "all";
    private string _roleFilter = "all";
    private bool _showAddForm;
    private bool _isLoading = true;
    private bool _isBusy;
    private bool _isError;
    private bool _editIsActive = true;
    private bool _createDeveloper;
    private Guid? _editingUserId;
    private Guid? _resetPasswordUserId;
    private string _resetPasswordDisplayName = string.Empty;
    private string _resetPasswordEmail = string.Empty;
    private string _resetPassword = string.Empty;
    private string _resetPasswordConfirm = string.Empty;
    private string _developerSearch = string.Empty;
    private string _selectedDeveloperId = string.Empty;
    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadUsersAsync(), LoadDevelopersAsync());
    }

    private IEnumerable<UserDto> FilteredUsers =>
        _users.Where(user =>
        {
            if (!string.Equals(_roleFilter, "all", StringComparison.OrdinalIgnoreCase)
                && !string.Equals(user.Role, _roleFilter, StringComparison.OrdinalIgnoreCase))
            {
                return false;
            }

            if (!string.Equals(_statusFilter, "all", StringComparison.OrdinalIgnoreCase))
            {
                var isActiveFilter = string.Equals(_statusFilter, "active", StringComparison.OrdinalIgnoreCase);
                if (user.IsActive != isActiveFilter)
                {
                    return false;
                }
            }

            if (string.IsNullOrWhiteSpace(_userSearch))
            {
                return true;
            }

            var search = _userSearch.Trim();
            return user.DisplayName.Contains(search, StringComparison.OrdinalIgnoreCase)
                || user.Email.Contains(search, StringComparison.OrdinalIgnoreCase);
        });

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(_userSearch)
        || !string.Equals(_statusFilter, "all", StringComparison.OrdinalIgnoreCase)
        || !string.Equals(_roleFilter, "all", StringComparison.OrdinalIgnoreCase);

    private void ClearFilters()
    {
        _userSearch = string.Empty;
        _statusFilter = "all";
        _roleFilter = "all";
    }

    private async Task LoadUsersAsync()
    {
        _isLoading = true;

        try
        {
            var users = await UserApi.GetUsersAsync();
            _users.Clear();
            _users.AddRange(users.OrderBy(u => u.DisplayName));
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadDevelopersAsync()
    {
        try
        {
            var developers = await DeveloperApi.GetDevelopersAsync();
            _developers.Clear();
            _developers.AddRange(developers.OrderBy(d => d.Name));
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = ex.Message;
        }
    }

    private IEnumerable<DeveloperDto> FilteredDevelopers
    {
        get
        {
            var linkedIds = _users
                .Where(u => u.DeveloperId.HasValue && u.Id != _editingUserId)
                .Select(u => u.DeveloperId!.Value)
                .ToHashSet();

            IEnumerable<DeveloperDto> available = _developers.Where(d => !linkedIds.Contains(d.Id));

            if (!string.IsNullOrWhiteSpace(_developerSearch))
            {
                var term = _developerSearch.Trim();
                available = available.Where(d =>
                    d.Name.Contains(term, StringComparison.OrdinalIgnoreCase)
                    || (d.Email?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            return available;
        }
    }

    private void ShowAddForm()
    {
        HideResetPasswordForm();
        _editingUserId = null;
        _newUser.Email = string.Empty;
        _newUser.Password = string.Empty;
        _newUser.DisplayName = string.Empty;
        _newUser.Role = AppRoles.User;
        _editIsActive = true;
        _createDeveloper = false;
        _selectedDeveloperId = string.Empty;
        _developerSearch = string.Empty;
        _showAddForm = true;
        _message = null;
    }

    private void EditUser(UserDto user)
    {
        HideResetPasswordForm();
        _editingUserId = user.Id;
        _newUser.Email = user.Email;
        _newUser.DisplayName = user.DisplayName;
        _newUser.Role = user.Role;
        _editIsActive = user.IsActive;
        _createDeveloper = false;
        _selectedDeveloperId = user.DeveloperId?.ToString() ?? string.Empty;
        _developerSearch = string.Empty;
        _showAddForm = true;
        _message = null;
    }

    private void HideForm()
    {
        _showAddForm = false;
        _editingUserId = null;
    }

    private void OnCreateDeveloperChanged()
    {
        if (_createDeveloper)
        {
            _selectedDeveloperId = string.Empty;
        }
    }

    private void ShowResetPasswordForm(UserDto user)
    {
        HideForm();
        _resetPasswordUserId = user.Id;
        _resetPasswordDisplayName = user.DisplayName;
        _resetPasswordEmail = user.Email;
        _resetPassword = string.Empty;
        _resetPasswordConfirm = string.Empty;
        _message = null;
    }

    private void HideResetPasswordForm()
    {
        _resetPasswordUserId = null;
        _resetPasswordDisplayName = string.Empty;
        _resetPasswordEmail = string.Empty;
        _resetPassword = string.Empty;
        _resetPasswordConfirm = string.Empty;
    }

    private async Task ResetPasswordAsync()
    {
        if (!_resetPasswordUserId.HasValue)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_resetPassword))
        {
            _isError = true;
            _message = "New password is required.";
            return;
        }

        if (_resetPassword != _resetPasswordConfirm)
        {
            _isError = true;
            _message = "Passwords do not match.";
            return;
        }

        _isBusy = true;
        _message = null;

        try
        {
            await UserApi.ChangePasswordAsync(_resetPasswordUserId.Value, new ChangePasswordRequest(_resetPassword));
            _isError = false;
            _message = $"Password reset for {_resetPasswordDisplayName}.";
            HideResetPasswordForm();
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task SaveUserAsync()
    {
        if (_createDeveloper && !string.IsNullOrWhiteSpace(_selectedDeveloperId))
        {
            _isError = true;
            _message = "Choose either an existing developer or creating a new one, not both.";
            return;
        }

        _isBusy = true;
        _message = null;

        try
        {
            Guid? developerId = Guid.TryParse(_selectedDeveloperId, out var parsedId) ? parsedId : null;

            if (_editingUserId.HasValue)
            {
                await UserApi.UpdateUserAsync(_editingUserId.Value, new UpdateUserRequest(
                    _newUser.DisplayName,
                    _newUser.Role,
                    _editIsActive,
                    developerId));
                _isError = false;
                _message = "User updated.";
            }
            else
            {
                await UserApi.CreateUserAsync(new CreateUserRequest(
                    _newUser.Email,
                    _newUser.Password,
                    _newUser.DisplayName,
                    _newUser.Role,
                    developerId,
                    _createDeveloper));
                _isError = false;
                _message = _createDeveloper
                    ? "User and developer profile created."
                    : developerId.HasValue
                        ? "User created and linked to developer."
                        : "User created.";
            }

            HideForm();
            await Task.WhenAll(LoadUsersAsync(), LoadDevelopersAsync());
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task DeleteUserAsync(Guid id)
    {
        _isBusy = true;
        _message = null;

        try
        {
            await UserApi.DeleteUserAsync(id);
            _isError = false;
            _message = "User deleted.";
            await LoadUsersAsync();
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private int GetActiveCount() => _users.Count(u => u.IsActive);

    private int GetAdminCount() => _users.Count(u => string.Equals(u.Role, AppRoles.Admin, StringComparison.OrdinalIgnoreCase));

    private int GetLinkedDeveloperCount() => _users.Count(u => u.DeveloperId.HasValue);

    private static string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "?";
        }

        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return parts.Length >= 2
            ? $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[1][0])}"
            : char.ToUpperInvariant(parts[0][0]).ToString();
    }

    private static string GetRoleAvatarClass(string role) =>
        string.Equals(role, AppRoles.Admin, StringComparison.OrdinalIgnoreCase)
            ? "users-avatar-admin"
            : "users-avatar-user";

    private static string GetRoleBadgeClass(string role) =>
        string.Equals(role, AppRoles.Admin, StringComparison.OrdinalIgnoreCase)
            ? "users-role-admin"
            : "users-role-user";

    private sealed class UserFormModel
    {
        public string Email { get; set; } = string.Empty;

        public string Password { get; set; } = string.Empty;

        public string DisplayName { get; set; } = string.Empty;

        public string Role { get; set; } = AppRoles.User;
    }
}
