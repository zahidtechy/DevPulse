@page "/attendance"
@attribute [Authorize]
@inject ToastService Toast
@inject IAttendanceApiClient AttendanceApi
@inject IDeveloperApiClient DeveloperApi
@inject AuthenticationStateProvider AuthStateProvider
@implements IDisposable

<PageTitle>@AppBranding.PageTitle("Attendance")</PageTitle>

<div class="attendance-page">
    <div class="analytics-hero analytics-hero-compact attendance-hero">
        <div class="analytics-hero-copy">
            <p class="analytics-eyebrow">Company · Attendance</p>
            <h1>Developer Attendance</h1>
            <p class="analytics-lead">
                Long-press the fingerprint button to punch in or out. Request a correction from Admin if you forget to punch.
            </p>
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="attendance-skeleton" aria-hidden="true">
            <div class="attendance-skeleton-stats">
                @for (var i = 0; i < 3; i++)
                {
                    <div class="attendance-skeleton-stat"></div>
                }
            </div>
            <div class="attendance-skeleton-tabs"></div>
            <div class="attendance-skeleton-card"></div>
        </div>
        <LoadingIndicator Text="Loading attendance..." />
    }
    else if (!_me.CanPunch && _me.DeveloperId is null)
    {
        <div class="leave-notice leave-notice-warning">
            <strong>Developer profile required</strong>
            <p class="mb-0">
                Your login email is not linked to a Developer record. Ask an administrator to match your user email with your Developer email.
            </p>
        </div>
    }
    else
    {
        <div class="attendance-workspace">
            <div class="filter-card card attendance-toolbar">
                <div class="card-body">
                    <div class="period-chips leave-tabs attendance-tabs" role="tablist" aria-label="Attendance sections">
                        <button type="button" role="tab" aria-selected="@(_tab == AttendanceTab.Today)" class="period-chip @(_tab == AttendanceTab.Today ? "active" : null)" @onclick="() => SetTab(AttendanceTab.Today)">
                            <span class="bi-clock-history attendance-tab-icon" aria-hidden="true"></span>
                            Today
                        </button>
                        <button type="button" role="tab" aria-selected="@(_tab == AttendanceTab.History)" class="period-chip @(_tab == AttendanceTab.History ? "active" : null)" @onclick="() => SetTab(AttendanceTab.History)">
                            <span class="bi-calendar3 attendance-tab-icon" aria-hidden="true"></span>
                            My history
                        </button>
                        <button type="button" role="tab" aria-selected="@(_tab == AttendanceTab.Corrections)" class="period-chip @(_tab == AttendanceTab.Corrections ? "active" : null)" @onclick="() => SetTab(AttendanceTab.Corrections)">
                            <span class="bi-pencil-square attendance-tab-icon" aria-hidden="true"></span>
                            Attendance corrections
                            @if (_isAdmin && GetAllPendingCorrectionCount() > 0)
                            {
                                <span class="leave-tab-count leave-tab-count-alert">@GetAllPendingCorrectionCount()</span>
                            }
                            @if (GetMyPendingCorrectionCount() > 0)
                            {
                                <span class="leave-tab-count leave-tab-count-user">@GetMyPendingCorrectionCount()</span>
                            }
                        </button>
                        <AuthorizeView Roles="@AppRoles.Admin">
                            <Authorized>
                                <button type="button" role="tab" aria-selected="@(_tab == AttendanceTab.AdminAnalytics)" class="period-chip @(_tab == AttendanceTab.AdminAnalytics ? "active" : null)" @onclick="() => SetTab(AttendanceTab.AdminAnalytics)">
                                    <span class="bi-bar-chart-line attendance-tab-icon" aria-hidden="true"></span>
                                    Analytics
                                </button>
                            </Authorized>
                        </AuthorizeView>
                    </div>

                    <div class="attendance-toolbar-stats" aria-label="Today's summary">
                        <div class="attendance-toolbar-stat">
                            <span class="attendance-toolbar-stat-label">Today</span>
                            <span class="attendance-toolbar-stat-value">@GetOfficeToday().ToString("ddd, MMM d")</span>
                        </div>
                        <div class="attendance-toolbar-stat">
                            <span class="attendance-toolbar-stat-label">Status</span>
                            <span class="attendance-toolbar-stat-value">
                                @if (_me.NextAction == AttendanceNextActionDto.Complete)
                                {
                                    <span class="attendance-badge complete">Complete</span>
                                }
                                else if (_me.NextAction == AttendanceNextActionDto.PunchOut)
                                {
                                    <span class="attendance-badge punched">Punched</span>
                                }
                                else
                                {
                                    <span class="attendance-toolbar-stat-muted">Not punched</span>
                                }
                            </span>
                        </div>
                        <div class="attendance-toolbar-stat">
                            <span class="attendance-toolbar-stat-label">Live clock</span>
                            <LiveClock TimeZoneId="_me.OfficeTimeZoneId" CssClass="attendance-toolbar-stat-value attendance-toolbar-clock" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="attendance-panel">
                @if (_tab == AttendanceTab.Today)
                {
                    <div class="attendance-today card form-card">
                        <div class="card-body">
                            <div class="attendance-today-layout">
                                <div class="attendance-today-punch">
                                    <div class="attendance-today-punch-meta">
                                        <span class="attendance-today-punch-day">@GetOfficeToday().ToString("dddd")</span>
                                        <LiveClock TimeZoneId="_me.OfficeTimeZoneId" CssClass="attendance-today-punch-clock" />
                                    </div>
                                    <FingerprintPunchButton NextAction="_me.NextAction"
                                                          IsDisabled="!CanUsePunchButton()"
                                                          IsLocked="@IsPunchLocked()"
                                                          IsBusy="_isPunching"
                                                          Hint="@GetPunchHint()"
                                                          OnPunchComplete="PunchAsync" />
                                </div>

                                <div class="attendance-today-main">
                                    <div class="attendance-today-header">
                                        <div>
                                            <p class="attendance-today-eyebrow">@GetOfficeToday().ToString("dddd") · @GetTimeZoneLabel()</p>
                                            <h2 class="attendance-today-date">@GetOfficeToday().ToString("MMMM d, yyyy")</h2>
                                        </div>
                                    </div>

                                    <div class="attendance-time-grid">
                                        <div class="attendance-time-tile @(_me.TodayRecord?.PunchInUtc is not null ? "filled" : null)">
                                            <span class="attendance-time-tile-icon bi-box-arrow-in-right" aria-hidden="true"></span>
                                            <span class="attendance-time-label">Punch in</span>
                                            <strong class="attendance-time-value">@AttendanceFormatter.FormatTime(_me.TodayRecord?.PunchInUtc, _me.OfficeTimeZoneId)</strong>
                                            @if (_me.TodayRecord?.PunchInIsCorrected == true)
                                            {
                                                <span class="attendance-badge corrected">Corrected</span>
                                            }
                                        </div>
                                        <div class="attendance-time-tile @(_me.TodayRecord?.PunchOutUtc is not null ? "filled" : null)">
                                            <span class="attendance-time-tile-icon bi-box-arrow-right" aria-hidden="true"></span>
                                            <span class="attendance-time-label">Punch out</span>
                                            <strong class="attendance-time-value">@AttendanceFormatter.FormatTime(_me.TodayRecord?.PunchOutUtc, _me.OfficeTimeZoneId)</strong>
                                            @if (_me.TodayRecord?.PunchOutIsCorrected == true)
                                            {
                                                <span class="attendance-badge corrected">Corrected</span>
                                            }
                                        </div>
                                        <div class="attendance-time-tile @(_me.TodayRecord?.PunchInUtc is not null ? "filled" : null)">
                                            <span class="attendance-time-tile-icon bi-hourglass-split" aria-hidden="true"></span>
                                            <span class="attendance-time-label">Hours worked</span>
                                            <LiveWorkDuration CssClass="attendance-time-value"
                                                              PunchInUtc="_me.TodayRecord?.PunchInUtc"
                                                              PunchOutUtc="_me.TodayRecord?.PunchOutUtc" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else if (_tab == AttendanceTab.History)
                {
                    <div class="attendance-filter-bar card form-card">
                        <div class="card-body">
                            <div class="attendance-filter-row">
                                <div class="attendance-filter-field">
                                    <label class="form-label">From</label>
                                    <input type="date" class="form-control" @bind="_historyFrom" />
                                </div>
                                <div class="attendance-filter-field">
                                    <label class="form-label">To</label>
                                    <input type="date" class="form-control" @bind="_historyTo" />
                                </div>
                                <div class="attendance-filter-action">
                                    <BusyButton CssClass="btn btn-primary" IsBusy="_isLoadingHistory" BusyText="Loading..." OnClick="LoadHistoryAsync">Load history</BusyButton>
                                </div>
                            </div>
                        </div>
                    </div>
                    @if (_isLoadingHistory)
                    {
                        <LoadingIndicator Text="Loading your attendance history..." Compact="true" />
                    }
                    else
                    {
                        <div class="attendance-table-scroll">
                            <AttendanceRecordsTable Records="_myHistory" OfficeTimeZoneId="_me.OfficeTimeZoneId" />
                        </div>
                    }
                }
                else if (_tab == AttendanceTab.Corrections)
                {
                    <div class="attendance-corrections-panel">
                        <div class="card form-card attendance-corrections-card">
                            <div class="card-body">
                                <div class="attendance-corrections-head">
                                    <div>
                                        <h5 class="card-title mb-1">Correction requests</h5>
                                        <AuthorizeView Roles="@AppRoles.Admin">
                                            <Authorized>
                                                <p class="attendance-section-desc mb-0">Review pending requests or check past decisions.</p>
                                            </Authorized>
                                            <NotAuthorized>
                                                <p class="attendance-section-desc mb-0">Track your requests and submit a new one when you miss a punch.</p>
                                            </NotAuthorized>
                                        </AuthorizeView>
                                    </div>
                                    <div class="attendance-section-actions">
                                        <BusyButton CssClass="btn btn-primary" OnClick="OpenCorrectionModal">
                                            <span class="bi-plus-lg me-1" aria-hidden="true"></span>
                                            Add request
                                        </BusyButton>
                                        <button type="button"
                                                class="attendance-collapse-toggle"
                                                aria-expanded="@_correctionRequestsExpanded.ToString().ToLowerInvariant()"
                                                aria-controls="attendance-correction-requests-content"
                                                aria-label="@(_correctionRequestsExpanded ? "Collapse correction requests" : "Expand correction requests")"
                                                title="@(_correctionRequestsExpanded ? "Collapse correction requests" : "Expand correction requests")"
                                                @onclick="ToggleCorrectionRequests">
                                            <span class="@(_correctionRequestsExpanded ? "bi-chevron-up" : "bi-chevron-down")" aria-hidden="true"></span>
                                        </button>
                                    </div>
                                </div>

                                <div id="attendance-correction-requests-content"
                                     class="attendance-collapsible-content"
                                     hidden="@(!_correctionRequestsExpanded)">
                                    <div class="attendance-filter-row attendance-corrections-filter-row @(_isAdmin ? null : "attendance-corrections-filter-row-user")">
                                        <div class="attendance-filter-field">
                                            <label class="form-label">From</label>
                                            <input type="date" class="form-control" @bind="_correctionFrom" />
                                        </div>
                                        <div class="attendance-filter-field">
                                            <label class="form-label">To</label>
                                            <input type="date" class="form-control" @bind="_correctionTo" />
                                        </div>
                                        @if (_isAdmin)
                                        {
                                            <div class="attendance-filter-field attendance-filter-field-wide">
                                                <label class="form-label">Developer</label>
                                                <select class="form-select" @bind="_correctionDeveloperId">
                                                    <option value="">All developers</option>
                                                    @foreach (var dev in _developers)
                                                    {
                                                        <option value="@dev.Id">@dev.Name</option>
                                                    }
                                                </select>
                                            </div>
                                        }
                                        <div class="attendance-filter-action">
                                            <BusyButton CssClass="btn btn-primary" IsBusy="_isLoadingCorrections" BusyText="..." OnClick="LoadCorrectionRequestsAsync">Load</BusyButton>
                                        </div>
                                    </div>

                                    @if (_isAdmin)
                                    {
                                        <div class="attendance-corrections-filter-chips" role="group" aria-label="Filter by status">
                                            <button type="button" class="period-chip @(_correctionStatusFilter is null ? "active" : null)" @onclick="() => _correctionStatusFilter = null">All</button>
                                            <button type="button" class="period-chip @(_correctionStatusFilter == AttendanceCorrectionStatusDto.Pending ? "active" : null)" @onclick="() => _correctionStatusFilter = AttendanceCorrectionStatusDto.Pending">Pending</button>
                                            <button type="button" class="period-chip @(_correctionStatusFilter == AttendanceCorrectionStatusDto.Approved ? "active" : null)" @onclick="() => _correctionStatusFilter = AttendanceCorrectionStatusDto.Approved">Approved</button>
                                            <button type="button" class="period-chip @(_correctionStatusFilter == AttendanceCorrectionStatusDto.Rejected ? "active" : null)" @onclick="() => _correctionStatusFilter = AttendanceCorrectionStatusDto.Rejected">Rejected</button>
                                        </div>
                                    }

                                    @if (_isLoadingCorrections)
                                    {
                                        <LoadingIndicator Text="Loading correction requests..." Compact="true" />
                                    }
                                    else
                                    {
                                        <div class="attendance-table-scroll attendance-correction-scroll">
                                            <AttendanceCorrectionsTable Requests="GetFilteredCorrections()"
                                                                        CanCancel="CanCancelCorrection"
                                                                        AllowReview="_isAdmin"
                                                                        OfficeTimeZoneId="_me.OfficeTimeZoneId"
                                                                        OnDetails="OpenDetails"
                                                                        OnCancel="CancelCorrectionAsync"
                                                                        OnApprove="id => OpenReviewModal(id, true)"
                                                                        OnReject="id => OpenReviewModal(id, false)" />
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                        @if (_isAdmin)
                        {
                            <div class="attendance-corrections-records">
                                <div class="attendance-filter-bar card form-card attendance-connected-records-card">
                                    <div class="card-body">
                                        <div class="attendance-corrections-head">
                                            <h5 class="card-title mb-0">All attendance records</h5>
                                            <button type="button"
                                                    class="attendance-collapse-toggle"
                                                    aria-expanded="@_attendanceRecordsExpanded.ToString().ToLowerInvariant()"
                                                    aria-controls="all-attendance-records-content"
                                                    aria-label="@(_attendanceRecordsExpanded ? "Collapse all attendance records" : "Expand all attendance records")"
                                                    title="@(_attendanceRecordsExpanded ? "Collapse all attendance records" : "Expand all attendance records")"
                                                    @onclick="ToggleAttendanceRecords">
                                                <span class="@(_attendanceRecordsExpanded ? "bi-chevron-up" : "bi-chevron-down")" aria-hidden="true"></span>
                                            </button>
                                        </div>
                                        <div id="all-attendance-records-content"
                                             class="attendance-collapsible-content"
                                             hidden="@(!_attendanceRecordsExpanded)">
                                            @AdminFilterFields("All attendance records", LoadAdminRecordsAsync, includeTitle: false)
                                            @if (_isAdminLoading)
                                            {
                                                <LoadingIndicator Text="Loading records..." Compact="true" />
                                            }
                                            else
                                            {
                                                <div class="attendance-table-scroll attendance-connected-records-scroll">
                                                    <AttendanceRecordsTable Records="_adminRecords" ShowDeveloper="true" ShowAdminEdit="true" OfficeTimeZoneId="_me.OfficeTimeZoneId" OnAdminEdit="AdminQuickFixAsync" />
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else if (_tab == AttendanceTab.AdminAnalytics)
                {
                    <AuthorizeView Roles="@AppRoles.Admin">
                        <Authorized>
                            @AdminFilterBar("Analytics period", LoadAnalyticsAsync)
                            @if (_isAdminLoading)
                            {
                                <LoadingIndicator Text="Loading analytics..." Compact="true" />
                            }
                            else if (_analytics is not null)
                            {
                                <div class="leave-stats attendance-analytics-kpi">
                                    <div class="leave-stat-card attendance-kpi-on-time">
                                        <span class="leave-stat-label">On-time</span>
                                        <span class="leave-stat-value">@_analytics.OnTimeCount <span class="leave-stat-unit">(@_analytics.OnTimePercent%)</span></span>
                                    </div>
                                    <div class="leave-stat-card attendance-kpi-late">
                                        <span class="leave-stat-label">Late</span>
                                        <span class="leave-stat-value">@_analytics.LateCount</span>
                                    </div>
                                    <div class="leave-stat-card attendance-kpi-early">
                                        <span class="leave-stat-label">Early leave</span>
                                        <span class="leave-stat-value">@_analytics.EarlyLeaveCount</span>
                                    </div>
                                    <div class="leave-stat-card attendance-kpi-incomplete">
                                        <span class="leave-stat-label">Incomplete</span>
                                        <span class="leave-stat-value">@_analytics.IncompleteCount</span>
                                    </div>
                                    <div class="leave-stat-card attendance-kpi-absent">
                                        <span class="leave-stat-label">Absent</span>
                                        <span class="leave-stat-value">@_analytics.AbsentCount</span>
                                    </div>
                                    <div class="leave-stat-card">
                                        <span class="leave-stat-label">Working days</span>
                                        <span class="leave-stat-value">@_analytics.WorkingDays</span>
                                    </div>
                                </div>
                            }
                        </Authorized>
                    </AuthorizeView>
                }
            </div>
        </div>
    }

    <ModalDialog IsVisible="_showCorrectionModal"
                 Title="Request missed punch"
                 IsBusy="_isSubmittingCorrection"
                 OnClose="CloseCorrectionModal">
        <ChildContent>
            <p class="attendance-section-desc mb-0">
                Submit a correction when you forgot to punch in or out. Requests can be made for the last 30 days.
            </p>

            <div class="attendance-correction-grid">
                <div class="attendance-correction-field">
                    <label class="form-label">Date</label>
                    <input type="date"
                           class="form-control"
                           min="@_minCorrectionDate"
                           max="@_maxCorrectionDate"
                           disabled="@(_isSubmittingCorrection || _isCheckingCorrectionPunches)"
                           @bind="_correctionDate"
                           @bind:format="yyyy-MM-dd"
                           @bind:after="CheckCorrectionPunchesAsync" />
                </div>
                <div class="attendance-correction-date-spacer" aria-hidden="true"></div>

                @if (_isCheckingCorrectionPunches)
                {
                    <div class="attendance-correction-state">
                        <LoadingIndicator Text="Checking existing punches..." Compact="true" />
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(_correctionPunchCheckError))
                {
                    <div class="attendance-correction-state alert alert-danger mb-0" role="alert">
                        <span>@_correctionPunchCheckError</span>
                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="CheckCorrectionPunchesAsync">Try again</button>
                    </div>
                }
                else if (_hasCheckedCorrectionPunches && !_canRequestPunchIn && !_canRequestPunchOut)
                {
                    <div class="attendance-correction-state alert alert-success mb-0" role="status">
                        Punch in and punch out already exist for this date.
                    </div>
                }
                else if (_hasCheckedCorrectionPunches)
                {
                    @if (_canRequestPunchIn)
                    {
                        <div class="attendance-correction-field">
                            <div class="attendance-correction-check">
                                <div class="form-check"><input class="form-check-input" type="checkbox" id="req-in" disabled="@_isSubmittingCorrection" @bind="_requestPunchIn" /><label class="form-check-label" for="req-in">Missed punch in</label></div>
                                @if (_requestPunchIn) { <input type="time" class="form-control mt-2" disabled="@_isSubmittingCorrection" @bind="_correctionPunchInTime" /> }
                            </div>
                        </div>
                    }
                    @if (_canRequestPunchOut)
                    {
                        <div class="attendance-correction-field">
                            <div class="attendance-correction-check">
                                <div class="form-check"><input class="form-check-input" type="checkbox" id="req-out" disabled="@_isSubmittingCorrection" @bind="_requestPunchOut" /><label class="form-check-label" for="req-out">Missed punch out</label></div>
                                @if (_requestPunchOut) { <input type="time" class="form-control mt-2" disabled="@_isSubmittingCorrection" @bind="_correctionPunchOutTime" /> }
                            </div>
                        </div>
                    }
                    <div class="attendance-correction-field attendance-correction-reason">
                        <label class="form-label">Reason</label>
                        <textarea class="form-control" rows="3" disabled="@_isSubmittingCorrection" @bind="_correctionReason" maxlength="1000" placeholder="Briefly explain why you missed the punch..."></textarea>
                    </div>
                }
            </div>
        </ChildContent>
        <FooterContent>
            <button type="button" class="btn btn-outline-secondary" disabled="@_isSubmittingCorrection" @onclick="CloseCorrectionModal">Cancel</button>
            @if (_hasCheckedCorrectionPunches && (_canRequestPunchIn || _canRequestPunchOut))
            {
                <BusyButton CssClass="btn btn-primary" IsBusy="_isSubmittingCorrection" BusyText="Submitting..." OnClick="SubmitCorrectionAsync">Submit request</BusyButton>
            }
        </FooterContent>
    </ModalDialog>

    <ModalDialog IsVisible="_showReviewModal"
                 Title="@(_reviewIsApprove ? "Approve correction request" : "Reject correction request")"
                 IsBusy="_isReviewingCorrection"
                 OnClose="CloseReviewModal">
        <ChildContent>
            @if (!string.IsNullOrWhiteSpace(_reviewError))
            {
                <div class="alert alert-danger" role="alert">@_reviewError</div>
            }

            <p class="attendance-section-desc mb-3">
                @(_reviewIsApprove
                    ? "Approving applies the requested punches to the attendance record."
                    : "Rejecting leaves the attendance record unchanged.")
            </p>

            <label class="form-label" for="review-comment">Reviewer comment (optional)</label>
            <textarea id="review-comment"
                      class="form-control"
                      rows="3"
                      maxlength="1000"
                      @bind="_reviewComment"
                      placeholder="Add a note for the developer..."></textarea>
        </ChildContent>
        <FooterContent>
            <button type="button" class="btn btn-outline-secondary" disabled="@_isReviewingCorrection" @onclick="CloseReviewModal">Cancel</button>
            <BusyButton CssClass="@(_reviewIsApprove ? "btn btn-success" : "btn btn-danger")"
                        IsBusy="_isReviewingCorrection"
                        BusyText="Saving..."
                        OnClick="SubmitReviewAsync">
                @(_reviewIsApprove ? "Approve" : "Reject")
            </BusyButton>
        </FooterContent>
    </ModalDialog>

    <ModalDialog IsVisible="_showDetailsModal"
                 Title="Correction details"
                 OnClose="CloseDetails">
        <ChildContent>
            @if (GetDetailsCorrection() is { } details)
            {
                <div class="attendance-details-grid">
                    <div>
                        <span class="attendance-details-label">Developer</span>
                        <span class="attendance-details-value">@details.DeveloperName</span>
                    </div>
                    <div>
                        <span class="attendance-details-label">Date</span>
                        <span class="attendance-details-value">@details.WorkDate.ToString("ddd, MMM d, yyyy")</span>
                    </div>
                    <div>
                        <span class="attendance-details-label">Requested punch in</span>
                        <span class="attendance-details-value">@AttendanceFormatter.FormatTime(details.RequestedPunchInUtc, _me.OfficeTimeZoneId)</span>
                    </div>
                    <div>
                        <span class="attendance-details-label">Requested punch out</span>
                        <span class="attendance-details-value">@AttendanceFormatter.FormatTime(details.RequestedPunchOutUtc, _me.OfficeTimeZoneId)</span>
                    </div>
                    <div>
                        <span class="attendance-details-label">Status</span>
                        <span class="attendance-badge @AttendanceFormatter.CorrectionStatusClass(details.Status)">@AttendanceFormatter.CorrectionStatusLabel(details.Status)</span>
                    </div>
                    <div>
                        <span class="attendance-details-label">Reason</span>
                        <p class="attendance-details-copy mb-0">@details.Reason</p>
                    </div>
                    <div>
                        <span class="attendance-details-label">Submitted on</span>
                        <span class="attendance-details-value">@AttendanceFormatter.FormatDateTime(details.CreatedAtUtc, _me.OfficeTimeZoneId)</span>
                    </div>
                    @if (details.ReviewedAtUtc is not null)
                    {
                        <div>
                            <span class="attendance-details-label">Reviewed on</span>
                            <span class="attendance-details-value">@AttendanceFormatter.FormatDateTime(details.ReviewedAtUtc, _me.OfficeTimeZoneId)</span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(details.ReviewerComment))
                    {
                        <div>
                            <span class="attendance-details-label">Reviewer comment</span>
                            <p class="attendance-details-copy mb-0">@details.ReviewerComment</p>
                        </div>
                    }
                </div>

                @if (CanCancelCorrection(details) || CanReviewCorrection(details))
                {
                    <div class="attendance-details-actions">
                        @if (CanCancelCorrection(details))
                        {
                            <button type="button" class="btn btn-outline-danger" @onclick="() => CancelFromDetailsAsync(details.Id)">Cancel request</button>
                        }
                        @if (CanReviewCorrection(details))
                        {
                            <div class="attendance-details-actions-row">
                                <button type="button" class="btn btn-success" @onclick="() => ReviewFromDetails(details.Id, true)">Approve</button>
                                <button type="button" class="btn btn-danger" @onclick="() => ReviewFromDetails(details.Id, false)">Reject</button>
                            </div>
                        }
                    </div>
                }
            }
        </ChildContent>
    </ModalDialog>
</div>

@code {
    private enum AttendanceTab { Today, History, Corrections, AdminAnalytics }

    private AttendanceTab _tab = AttendanceTab.Today;
    private AttendanceMeDto _me = new(null, null, false, AttendanceNextActionDto.PunchIn, null, "Asia/Dhaka");
    private AttendanceAnalyticsSummaryDto? _analytics;
    private IReadOnlyList<AttendanceRecordDto> _myHistory = [];
    private IReadOnlyList<AttendanceRecordDto> _adminRecords = [];
    private IReadOnlyList<AttendanceCorrectionRequestDto> _corrections = [];
    private IReadOnlyList<DeveloperDto> _developers = [];

    private bool _isAdmin;
    private bool _isLoading = true;
    private bool _isPunching;
    private bool _isLoadingHistory;
    private bool _isSubmittingCorrection;
    private bool _isLoadingCorrections;
    private bool _isCheckingCorrectionPunches;
    private bool _hasCheckedCorrectionPunches;
    private bool _canRequestPunchIn;
    private bool _canRequestPunchOut;
    private bool _isAdminLoading;
    private bool _correctionRequestsExpanded = true;
    private bool _attendanceRecordsExpanded = true;

    private DateOnly _historyFrom;
    private DateOnly _historyTo;
    private DateOnly _adminFrom;
    private DateOnly _adminTo;
    private string? _adminDeveloperId;
    private string? _correctionDeveloperId;
    private AttendanceCorrectionStatusDto? _correctionStatusFilter;
    private string? _appliedCorrectionDeveloperId;
    private AttendanceCorrectionStatusDto? _appliedCorrectionStatusFilter;
    private string _maxCorrectionDate = DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd");
    private string _minCorrectionDate = DateOnly.FromDateTime(DateTime.Today).AddDays(-30).ToString("yyyy-MM-dd");
    private bool _showCorrectionModal;
    private bool _showDetailsModal;
    private Guid? _detailsCorrectionId;
    private bool _showReviewModal;
    private bool _isReviewingCorrection;
    private bool _reviewIsApprove;
    private Guid? _reviewCorrectionId;
    private string _reviewComment = string.Empty;
    private string? _reviewError;

    private DateOnly _correctionFrom;
    private DateOnly _correctionTo;
    private DateOnly _appliedCorrectionFrom;
    private DateOnly _appliedCorrectionTo;
    private DateOnly _correctionDate = DateOnly.FromDateTime(DateTime.Today);
    private bool _requestPunchIn = true;
    private bool _requestPunchOut;
    private TimeOnly _correctionPunchInTime = new(9, 0);
    private TimeOnly _correctionPunchOutTime = new(18, 0);
    private string _correctionReason = string.Empty;
    private string? _correctionPunchCheckError;
    private int _correctionPunchCheckVersion;
    private Timer? _punchWindowTimer;
    private Timer? _meRefreshTimer;
    private bool _isRefreshingMe;
    private int _meVersion;
    private string? _refreshError;

    protected override async Task OnInitializedAsync()
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        _historyFrom = today.AddDays(-30);
        _historyTo = today;
        _adminFrom = today.AddDays(-30);
        _adminTo = today;
        _correctionFrom = today.AddDays(-30);
        _correctionTo = today;
        _appliedCorrectionFrom = _correctionFrom;
        _appliedCorrectionTo = _correctionTo;
        _punchWindowTimer = new Timer(_ => InvokeAsync(StateHasChanged), null, TimeSpan.FromSeconds(15), TimeSpan.FromSeconds(15));
        _meRefreshTimer = new Timer(_ => _ = InvokeAsync(RefreshMeAsync), null, TimeSpan.FromSeconds(60), TimeSpan.FromSeconds(60));
        await LoadAsync();
    }

    private bool CanUsePunchButton()
    {
        if (!_me.CanPunch)
        {
            return false;
        }

        if (_me.NextAction == AttendanceNextActionDto.Complete)
        {
            return false;
        }

        if (_me.NextAction == AttendanceNextActionDto.PunchIn && !IsPunchInAllowed())
        {
            return false;
        }

        if (_me.NextAction == AttendanceNextActionDto.PunchOut && !IsPunchOutAllowed())
        {
            return false;
        }

        return true;
    }

    private bool IsPunchLocked() =>
        (_me.NextAction == AttendanceNextActionDto.PunchIn && !IsPunchInAllowed())
        || (_me.NextAction == AttendanceNextActionDto.PunchOut && !IsPunchOutAllowed());

    private bool IsPunchInAllowed()
    {
        if (_me.PunchInEarliestTime is null)
        {
            return _me.CanPunchIn;
        }

        var currentTime = GetOfficeCurrentTime();
        if (currentTime is null)
        {
            return _me.CanPunchIn;
        }

        return currentTime >= _me.PunchInEarliestTime.Value
            && (_me.PunchInLatestTime is null || currentTime <= _me.PunchInLatestTime.Value);
    }

    private bool IsPunchOutAllowed()
    {
        if (_me.PunchOutEarliestTime is null)
        {
            return _me.CanPunchOut;
        }

        var currentTime = GetOfficeCurrentTime();
        if (currentTime is null)
        {
            return _me.CanPunchOut;
        }

        return currentTime >= _me.PunchOutEarliestTime.Value
            && (_me.PunchOutLatestTime is null || currentTime <= _me.PunchOutLatestTime.Value);
    }

    private TimeOnly? GetOfficeCurrentTime()
    {
        try
        {
            var tz = TimeZoneInfo.FindSystemTimeZoneById(_me.OfficeTimeZoneId);
            return TimeOnly.FromDateTime(TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, tz));
        }
        catch
        {
            return null;
        }
    }

    private string FormatPunchTime(TimeOnly? time)
    {
        if (time is null)
        {
            return "the configured time";
        }

        return DateTime.Today.Add(time.Value.ToTimeSpan()).ToString("h:mm tt");
    }

    private RenderFragment AdminFilterBar(string title, Func<Task> loadAction) => @<div class="attendance-filter-bar card form-card">
        <div class="card-body">
            @AdminFilterFields(title, loadAction)
        </div>
    </div>;

    private RenderFragment AdminFilterFields(string title, Func<Task> loadAction, bool includeTitle = true) => @<text>
        @if (includeTitle)
        {
            <span class="filter-section-label attendance-filter-title">@title</span>
        }
        <div class="attendance-filter-row attendance-filter-row-admin">
            <div class="attendance-filter-field">
                <label class="form-label">From</label>
                <input type="date" class="form-control" @bind="_adminFrom" />
            </div>
            <div class="attendance-filter-field">
                <label class="form-label">To</label>
                <input type="date" class="form-control" @bind="_adminTo" />
            </div>
            <div class="attendance-filter-field attendance-filter-field-wide">
                <label class="form-label">Developer</label>
                <select class="form-select" @bind="_adminDeveloperId">
                    <option value="">All developers</option>
                    @foreach (var dev in _developers) { <option value="@dev.Id">@dev.Name</option> }
                </select>
            </div>
            <div class="attendance-filter-action">
                <BusyButton CssClass="btn btn-primary" IsBusy="_isAdminLoading" BusyText="..." OnClick="loadAction">Load</BusyButton>
            </div>
        </div>
        <div class="d-flex gap-2 flex-wrap mt-2">
            <button type="button" class="period-chip" disabled="@_isAdminLoading" @onclick="() => SetAdminRangePresetAsync(0, 0, loadAction)">Today</button>
            <button type="button" class="period-chip" disabled="@_isAdminLoading" @onclick="() => SetAdminRangePresetAsync(-1, -1, loadAction)">Yesterday</button>
            <button type="button" class="period-chip" disabled="@_isAdminLoading" @onclick="() => SetAdminRangePresetAsync(-30, 0, loadAction)">Last 30 days</button>
        </div>
    </text>;

    private void ToggleCorrectionRequests() =>
        _correctionRequestsExpanded = !_correctionRequestsExpanded;

    private void ToggleAttendanceRecords() =>
        _attendanceRecordsExpanded = !_attendanceRecordsExpanded;

    private async Task LoadAsync()
    {
        _isLoading = true;
        try
        {
            ApplyMe(await AttendanceApi.GetMeAsync());

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            _isAdmin = authState.User.IsInRole(AppRoles.Admin);

            if (_isAdmin)
            {
                var developersTask = DeveloperApi.GetDevelopersAsync();
                var correctionsTask = AttendanceApi.GetCorrectionRequestsAsync();
                await Task.WhenAll(developersTask, correctionsTask);
                _developers = await developersTask;
                _corrections = await correctionsTask;
            }
            else
            {
                _corrections = await AttendanceApi.GetMyCorrectionRequestsAsync();
            }
        }
        catch (Exception ex) { Toast.Error(ex.Message, key: ToastKeys.Attendance); }
        finally { _isLoading = false; }
    }

    private void ApplyMe(AttendanceMeDto me)
    {
        _me = me;
        _meVersion++;
        _maxCorrectionDate = GetOfficeToday().ToString("yyyy-MM-dd");
        _minCorrectionDate = GetOfficeToday().AddDays(-30).ToString("yyyy-MM-dd");
    }

    private void SetActionMessage(string successMessage, string? toastKey = null)
    {
        if (string.IsNullOrWhiteSpace(_refreshError))
        {
            Toast.Success(successMessage, key: toastKey ?? ToastKeys.Attendance);
            return;
        }

        // The action itself succeeded, but one or more lists failed to refresh. Keep the
        // original combined message so the user knows the views may be stale, and show it
        // as an error (sticky) since they may need to reload.
        Toast.Error($"{successMessage} Some attendance lists could not be refreshed. {_refreshError}", key: toastKey ?? ToastKeys.Attendance);
        _refreshError = null;
    }

    private void NoteRefreshError(Exception ex, bool notify)
    {
        _refreshError = ex.Message;

        if (notify)
        {
            Toast.Error(ex.Message, key: ToastKeys.Attendance);
        }
    }

    private async Task RefreshMeAsync()
    {
        if (_isRefreshingMe || _isPunching || _isLoading)
        {
            return;
        }

        _isRefreshingMe = true;
        var version = _meVersion;
        try
        {
            var me = await AttendanceApi.GetMeAsync();
            if (_isPunching || version != _meVersion)
            {
                return;
            }

            ApplyMe(me);
            StateHasChanged();
        }
        catch
        {
            // Background refresh is best effort; keep the last known state.
        }
        finally
        {
            _isRefreshingMe = false;
        }
    }

    private async Task RefreshMeBestEffortAsync()
    {
        try
        {
            ApplyMe(await AttendanceApi.GetMeAsync());
        }
        catch
        {
            // Keep the last known state; the 60-second background refresh will retry.
        }
    }

    private async Task PunchAsync()
    {
        _isPunching = true;
        _refreshError = null;
        try
        {
            var result = await AttendanceApi.PunchAsync();
            if (result is not null)
            {
                await RefreshMeBestEffortAsync();
                // TEMPORARY: same-session refresh only (see note in SubmitCorrectionAsync).
                await LoadHistoryAsync(notifyOnError: false);
                var authState = await AuthStateProvider.GetAuthenticationStateAsync();
                if (authState.User.IsInRole(AppRoles.Admin))
                {
                    await LoadAdminRecordsAsync(notifyOnError: false);
                    await LoadAnalyticsAsync(notifyOnError: false);
                }

                var successMessage = result.NextAction == AttendanceNextActionDto.PunchOut ? "Punch in recorded." :
                    result.NextAction == AttendanceNextActionDto.Complete ? "Punch out recorded. Day complete." : "Punch recorded.";
                SetActionMessage(successMessage);
            }
        }
        catch (Exception ex) { Toast.Error(ex.Message, key: ToastKeys.Attendance); }
        finally { _isPunching = false; }
    }

    private Task LoadHistoryAsync() => LoadHistoryAsync(notifyOnError: true);

    private async Task LoadHistoryAsync(bool notifyOnError)
    {
        _isLoadingHistory = true;
        try { _myHistory = await AttendanceApi.GetMyHistoryAsync(_historyFrom, _historyTo); }
        catch (Exception ex) { NoteRefreshError(ex, notifyOnError); }
        finally { _isLoadingHistory = false; }
    }

    private async Task OpenCorrectionModal()
    {
        _showCorrectionModal = true;
        await CheckCorrectionPunchesAsync();
    }

    private void CloseCorrectionModal()
    {
        if (_isSubmittingCorrection)
        {
            return;
        }

        _correctionPunchCheckVersion++;
        _isCheckingCorrectionPunches = false;
        _showCorrectionModal = false;
    }

    private async Task CheckCorrectionPunchesAsync()
    {
        var date = _correctionDate;
        var checkVersion = ++_correctionPunchCheckVersion;

        _isCheckingCorrectionPunches = true;
        _hasCheckedCorrectionPunches = false;
        _canRequestPunchIn = false;
        _canRequestPunchOut = false;
        _requestPunchIn = false;
        _requestPunchOut = false;
        _correctionPunchCheckError = null;

        try
        {
            var records = await AttendanceApi.GetMyHistoryAsync(date, date);
            if (checkVersion != _correctionPunchCheckVersion || !_showCorrectionModal)
            {
                return;
            }

            var record = records.FirstOrDefault(r => r.WorkDate == date);
            _canRequestPunchIn = record?.PunchInUtc is null;
            _canRequestPunchOut = record?.PunchOutUtc is null;
            _hasCheckedCorrectionPunches = true;
        }
        catch (Exception ex)
        {
            if (checkVersion == _correctionPunchCheckVersion && _showCorrectionModal)
            {
                _correctionPunchCheckError = $"Could not check existing punches. {ex.Message}";
            }
        }
        finally
        {
            if (checkVersion == _correctionPunchCheckVersion)
            {
                _isCheckingCorrectionPunches = false;
            }
        }
    }

    private async Task SubmitCorrectionAsync()
    {
        if (!_hasCheckedCorrectionPunches || _isCheckingCorrectionPunches)
        {
            return;
        }

        if (!_requestPunchIn && !_requestPunchOut)
        {
            Toast.Error("Select at least one punch to correct.", key: ToastKeys.AttendanceCorrectionSubmit);
            return;
        }

        if (string.IsNullOrWhiteSpace(_correctionReason))
        {
            Toast.Error("Reason is required.", key: ToastKeys.AttendanceCorrectionSubmit);
            return;
        }

        _isSubmittingCorrection = true;
        _refreshError = null;
        try
        {
            await AttendanceApi.SubmitCorrectionRequestAsync(new CreateAttendanceCorrectionRequest(
                _correctionDate,
                _requestPunchIn ? ToUtc(_correctionDate, _correctionPunchInTime) : null,
                _requestPunchOut ? ToUtc(_correctionDate, _correctionPunchOutTime) : null,
                _correctionReason));
            // TEMPORARY: manually refresh every attendance list after each mutation so all
            // tabs show fresh data in this session. Cross-session views still go stale (no
            // SignalR/polling yet) — decide on a real-time strategy (SignalR hub vs polling)
            // before treating this as final.
            try
            {
                await LoadCorrectionsAsync();
            }
            catch (Exception ex)
            {
                NoteRefreshError(ex, notify: false);
            }

            await LoadHistoryAsync(notifyOnError: false);
            if (_isAdmin)
            {
                await LoadAdminRecordsAsync(notifyOnError: false);
            }

            _correctionReason = string.Empty;
            _showCorrectionModal = false;
            SetActionMessage("Correction request submitted.", ToastKeys.AttendanceCorrectionSubmit);
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message, key: ToastKeys.AttendanceCorrectionSubmit);
        }
        finally { _isSubmittingCorrection = false; }
    }

    private async Task LoadCorrectionsAsync()
    {
        _corrections = _isAdmin
            ? await AttendanceApi.GetCorrectionRequestsAsync()
            : await AttendanceApi.GetMyCorrectionRequestsAsync();
    }

    private async Task LoadCorrectionRequestsAsync()
    {
        var from = _correctionFrom;
        var to = _correctionTo;
        var developerId = _correctionDeveloperId;
        var status = _correctionStatusFilter;

        _isLoadingCorrections = true;
        try
        {
            await LoadCorrectionsAsync();
            _appliedCorrectionFrom = from;
            _appliedCorrectionTo = to;
            _appliedCorrectionDeveloperId = developerId;
            _appliedCorrectionStatusFilter = status;
        }
        catch (Exception ex)
        {
            NoteRefreshError(ex, notify: true);
        }
        finally
        {
            _isLoadingCorrections = false;
        }
    }

    private async Task RefreshCorrectionsAsync()
    {
        try
        {
            await LoadCorrectionsAsync();
        }
        catch (Exception ex)
        {
            NoteRefreshError(ex, notify: false);
        }

        StateHasChanged();
    }

    private Task LoadAdminRecordsAsync() => LoadAdminRecordsAsync(notifyOnError: true);

    private async Task LoadAdminRecordsAsync(bool notifyOnError)
    {
        _isAdminLoading = true;
        try
        {
            Guid? developerId = Guid.TryParse(_adminDeveloperId, out var id) ? id : null;
            _adminRecords = await AttendanceApi.GetRecordsAsync(_adminFrom, _adminTo, developerId);
        }
        catch (Exception ex) { NoteRefreshError(ex, notifyOnError); }
        finally { _isAdminLoading = false; }
    }

    private async Task SetAdminRangePresetAsync(int fromOffsetDays, int toOffsetDays, Func<Task> loadAction)
    {
        if (_isAdminLoading)
        {
            return;
        }

        var today = GetOfficeToday();
        _adminFrom = today.AddDays(fromOffsetDays);
        _adminTo = today.AddDays(toOffsetDays);
        await loadAction();
    }

    private Task LoadAnalyticsAsync() => LoadAnalyticsAsync(notifyOnError: true);

    private async Task LoadAnalyticsAsync(bool notifyOnError)
    {
        _isAdminLoading = true;
        try { _analytics = await AttendanceApi.GetAnalyticsAsync(_adminFrom, _adminTo); }
        catch (Exception ex) { NoteRefreshError(ex, notifyOnError); }
        finally { _isAdminLoading = false; }
    }

    private void OpenDetails(Guid id)
    {
        _detailsCorrectionId = id;
        _showDetailsModal = true;
    }

    private void CloseDetails()
    {
        _showDetailsModal = false;
        _detailsCorrectionId = null;
    }

    private AttendanceCorrectionRequestDto? GetDetailsCorrection() =>
        _detailsCorrectionId is null
            ? null
            : _corrections.FirstOrDefault(r => r.Id == _detailsCorrectionId.Value);

    // Admins may only cancel their own requests (they approve or reject everyone else's).
    private bool CanCancelCorrection(AttendanceCorrectionRequestDto request) =>
        request.Status == AttendanceCorrectionStatusDto.Pending
        && (!_isAdmin || request.DeveloperId == _me.DeveloperId);

    private bool CanReviewCorrection(AttendanceCorrectionRequestDto request) =>
        _isAdmin && request.Status == AttendanceCorrectionStatusDto.Pending;

    private async Task CancelFromDetailsAsync(Guid id)
    {
        CloseDetails();
        await CancelCorrectionAsync(id);
    }

    private void ReviewFromDetails(Guid id, bool approve)
    {
        CloseDetails();
        OpenReviewModal(id, approve);
    }

    private void OpenReviewModal(Guid id, bool approve)
    {
        _reviewCorrectionId = id;
        _reviewIsApprove = approve;
        _reviewComment = string.Empty;
        _reviewError = null;
        _showReviewModal = true;
    }

    private void CloseReviewModal()
    {
        if (_isReviewingCorrection)
        {
            return;
        }

        _showReviewModal = false;
        _reviewError = null;
    }

    private async Task SubmitReviewAsync()
    {
        if (_reviewCorrectionId is null)
        {
            return;
        }

        _isReviewingCorrection = true;
        _reviewError = null;
        _refreshError = null;
        var comment = string.IsNullOrWhiteSpace(_reviewComment) ? null : _reviewComment.Trim();

        try
        {
            // TEMPORARY: same-session refresh only (see note in SubmitCorrectionAsync).
            if (_reviewIsApprove)
            {
                await AttendanceApi.ApproveCorrectionRequestAsync(
                    _reviewCorrectionId.Value,
                    new ReviewAttendanceCorrectionRequest(null, null, comment));
                await RefreshMeBestEffortAsync();
                await LoadCorrectionsAsync();
                await LoadHistoryAsync(notifyOnError: false);
                await LoadAdminRecordsAsync(notifyOnError: false);
                await LoadAnalyticsAsync(notifyOnError: false);
                SetActionMessage("Correction request approved.");
            }
            else
            {
                await AttendanceApi.RejectCorrectionRequestAsync(
                    _reviewCorrectionId.Value,
                    new RejectAttendanceCorrectionRequest(comment));
                await LoadCorrectionsAsync();
                await LoadHistoryAsync(notifyOnError: false);
                await LoadAdminRecordsAsync(notifyOnError: false);
                SetActionMessage("Correction request rejected.");
            }

            _showReviewModal = false;
            _reviewCorrectionId = null;
            _reviewComment = string.Empty;
        }
        catch (Exception ex)
        {
            _reviewError = ex.Message;
        }
        finally
        {
            _isReviewingCorrection = false;
        }
    }

    private async Task CancelCorrectionAsync(Guid id)
    {
        _refreshError = null;
        try
        {
            await AttendanceApi.CancelCorrectionRequestAsync(id);
            await LoadCorrectionsAsync();
            SetActionMessage("Correction request cancelled.");
        }
        catch (Exception ex) { Toast.Error(ex.Message, key: ToastKeys.Attendance); }
    }

    private async Task AdminQuickFixAsync(AttendanceRecordDto record)
    {
        _refreshError = null;
        try
        {
            await AttendanceApi.AdminUpsertRecordAsync(record.DeveloperId, record.WorkDate,
                new AdminUpsertAttendanceRecordRequest(
                    record.PunchInUtc ?? ToUtc(record.WorkDate, new TimeOnly(9, 0)),
                    record.PunchOutUtc ?? ToUtc(record.WorkDate, new TimeOnly(18, 0))));
            await RefreshMeBestEffortAsync();
            await LoadAdminRecordsAsync(notifyOnError: false);
            await LoadHistoryAsync(notifyOnError: false);
            await LoadAnalyticsAsync(notifyOnError: false);
            SetActionMessage("Attendance record updated.");
        }
        catch (Exception ex) { Toast.Error(ex.Message, key: ToastKeys.Attendance); }
    }

    private void SetTab(AttendanceTab tab)
    {
        _tab = tab;
        if (tab == AttendanceTab.History && _myHistory.Count == 0) _ = LoadHistoryAsync();
        else if (tab == AttendanceTab.Corrections)
        {
            _ = RefreshCorrectionsAsync();
            // Admins also get the all-records grid below the corrections table.
            if (_isAdmin && _adminRecords.Count == 0) _ = LoadAdminRecordsAsync();
        }
        else if (tab == AttendanceTab.AdminAnalytics && _analytics is null) _ = LoadAnalyticsAsync();
    }

    private int GetAllPendingCorrectionCount() =>
        _corrections.Count(r => r.Status == AttendanceCorrectionStatusDto.Pending);

    private int GetMyPendingCorrectionCount()
    {
        if (!_isAdmin)
        {
            return GetAllPendingCorrectionCount();
        }

        return _me.DeveloperId is null
            ? 0
            : _corrections.Count(r => r.Status == AttendanceCorrectionStatusDto.Pending
                                       && r.DeveloperId == _me.DeveloperId);
    }

    private IReadOnlyList<AttendanceCorrectionRequestDto> GetFilteredCorrections()
    {
        IEnumerable<AttendanceCorrectionRequestDto> query = _corrections
            .Where(r => r.WorkDate >= _appliedCorrectionFrom && r.WorkDate <= _appliedCorrectionTo);

        if (_isAdmin)
        {
            if (_appliedCorrectionStatusFilter is not null)
            {
                query = query.Where(r => r.Status == _appliedCorrectionStatusFilter.Value);
            }

            if (Guid.TryParse(_appliedCorrectionDeveloperId, out var developerId))
            {
                query = query.Where(r => r.DeveloperId == developerId);
            }
        }

        // Ordering (pending first, newest first) is applied by the API for both the admin
        // and the developer list, so filtering never re-sorts.
        return query.ToList();
    }

    private string GetPunchHint() => _me.NextAction switch
    {
        AttendanceNextActionDto.PunchIn when !IsPunchInAllowed() => GetPunchInLockedHint(),
        AttendanceNextActionDto.PunchIn => "Press and hold the fingerprint for about one second.",
        AttendanceNextActionDto.PunchOut when !IsPunchOutAllowed() => GetPunchOutLockedHint(),
        AttendanceNextActionDto.PunchOut => $"Hold again when you are ready to leave. Punch out closes at {FormatPunchTime(_me.PunchOutLatestTime)}.",
        AttendanceNextActionDto.Complete => "You have already punched in and out today.",
        _ => string.Empty
    };

    private string GetTimeZoneLabel()
    {
        try
        {
            var tz = TimeZoneInfo.FindSystemTimeZoneById(_me.OfficeTimeZoneId);
            return tz.IsDaylightSavingTime(DateTime.UtcNow)
                ? tz.DaylightName
                : tz.StandardName;
        }
        catch
        {
            return _me.OfficeTimeZoneId;
        }
    }

    private DateOnly GetOfficeToday()
    {
        try
        {
            var tz = TimeZoneInfo.FindSystemTimeZoneById(_me.OfficeTimeZoneId);
            return DateOnly.FromDateTime(TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, tz));
        }
        catch { return DateOnly.FromDateTime(DateTime.Today); }
    }

    private DateTime? ToUtc(DateOnly date, TimeOnly time)
    {
        try
        {
            var tz = TimeZoneInfo.FindSystemTimeZoneById(_me.OfficeTimeZoneId);
            return TimeZoneInfo.ConvertTimeToUtc(DateTime.SpecifyKind(date.ToDateTime(time), DateTimeKind.Unspecified), tz);
        }
        catch { return date.ToDateTime(time).ToUniversalTime(); }
    }

    private string GetPunchInLockedHint()
    {
        var currentTime = GetOfficeCurrentTime();
        if (currentTime is not null
            && _me.PunchInLatestTime is not null
            && currentTime > _me.PunchInLatestTime.Value)
        {
            return $"Punch in closed at {FormatPunchTime(_me.PunchInLatestTime)}. Submit an attendance correction if needed.";
        }

        return $"Punch in opens at {FormatPunchTime(_me.PunchInEarliestTime)}.";
    }

    private string GetPunchOutLockedHint()
    {
        var currentTime = GetOfficeCurrentTime();
        if (currentTime is not null
            && _me.PunchOutLatestTime is not null
            && currentTime > _me.PunchOutLatestTime.Value)
        {
            return $"Punch out closed at {FormatPunchTime(_me.PunchOutLatestTime)}.";
        }

        return $"Punch out is available after {FormatPunchTime(_me.PunchOutEarliestTime)} until {FormatPunchTime(_me.PunchOutLatestTime)}.";
    }

    public void Dispose()
    {
        _punchWindowTimer?.Dispose();
        _meRefreshTimer?.Dispose();
        _correctionPunchCheckVersion++;
    }
}
