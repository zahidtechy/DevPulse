    private async Task LoadAsync()
    {
        _isLoading = true;
        try
        {
            var meTask = AttendanceApi.GetMeAsync();
            var authStateTask = AuthStateProvider.GetAuthenticationStateAsync();
            await Task.WhenAll(meTask, authStateTask);

            ApplyMe(await meTask);
            var authState = await authStateTask;
            _isAdmin = authState.User.IsInRole(AppRoles.Admin);

            if (_isAdmin)
            {
                _developers = await DeveloperApi.GetDevelopersAsync();
            }
        }
        catch (Exception ex) { Toast.Error(ex.Message, key: ToastKeys.Attendance); }
        finally { _isLoading = false; }
    }

    private void ApplyMe(AttendanceMeDto me)
    {
        _me = me;
        _meVersion++;
        _maxCorrectionDate = GetOfficeToday().ToString("yyyy-MM-dd");
        _minCorrectionDate = GetOfficeToday().AddDays(-30).ToString("yyyy-MM-dd");
    }

    private void SetActionMessage(string successMessage, string? toastKey = null)
    {
        if (string.IsNullOrWhiteSpace(_refreshError))
        {
            Toast.Success(successMessage, key: toastKey ?? ToastKeys.Attendance);
            return;
        }

        // The action itself succeeded, but one or more lists failed to refresh. Keep the
        // original combined message so the user knows the views may be stale, and show it
        // as an error (sticky) since they may need to reload.
        Toast.Error($"{successMessage} Some attendance lists could not be refreshed. {_refreshError}", key: toastKey ?? ToastKeys.Attendance);
        _refreshError = null;
    }

    private void NoteRefreshError(Exception ex, bool notify)
    {
        _refreshError = ex.Message;

        if (notify)
        {
            Toast.Error(ex.Message, key: ToastKeys.Attendance);
        }
    }

    private async Task RefreshMeAsync()
    {
        if (_isRefreshingMe || _isPunching || _isLoading)
        {
            return;
        }

        _isRefreshingMe = true;
        var version = _meVersion;
        try
        {
            var me = await AttendanceApi.GetMeAsync();
            if (_isPunching || version != _meVersion)
            {
                return;
            }

            ApplyMe(me);
            StateHasChanged();
        }
        catch
        {
            // Background refresh is best effort; keep the last known state.
        }
        finally
        {
            _isRefreshingMe = false;
        }
    }

    private async Task RefreshMeBestEffortAsync()
    {
        try
        {
            ApplyMe(await AttendanceApi.GetMeAsync());
        }
        catch
        {
            // Keep the last known state; the 60-second background refresh will retry.
        }
    }

    private async Task PunchAsync()
    {
        _isPunching = true;
        _refreshError = null;
        try
        {
            var result = await AttendanceApi.PunchAsync();
            if (result is not null)
            {
                await RefreshMeBestEffortAsync();
                await RefreshAttendanceDaysIfLoadedAsync();
                if (_isAdmin && _analytics is not null)
                {
                    await LoadAnalyticsAsync(notifyOnError: false);
                }

                var successMessage = result.NextAction == AttendanceNextActionDto.PunchOut ? "Punch in recorded." :
                    result.NextAction == AttendanceNextActionDto.Complete ? "Punch out recorded. Day complete." : "Punch recorded.";
                SetActionMessage(successMessage);
            }
        }
        catch (Exception ex) { Toast.Error(ex.Message, key: ToastKeys.Attendance); }
        finally { _isPunching = false; }
    }

    private Task LoadAttendanceDaysAsync()
    {
        // Status is evaluated client-side, but it is staged like the date and developer
        // controls so the visible grid changes only after a successful Load.
        Guid? developerId = _isAdmin && Guid.TryParse(_recordsDeveloperId, out var id) ? id : null;
        _ = LoadPendingCorrectionCountsAsync();
        return LoadAttendanceDaysAsync(
            _recordsFrom,
            _recordsTo,
            developerId,
            _recordsStatusFilter,
            applyFilters: true,
            notifyOnError: true);
    }

    private Task PrefetchAttendanceDaysAsync() =>
        LoadAttendanceDaysAsync(
            _recordsFrom,
            _recordsTo,
            developerId: null,
            _recordsStatusFilter,
            applyFilters: true,
            notifyOnError: false,
            trackRefreshError: false);

    private async Task LoadAttendanceDaysAsync(
        DateOnly from,
        DateOnly to,
        Guid? developerId,
        AttendanceRowStatusFilter statusFilter,
        bool applyFilters,
        bool notifyOnError,
        bool trackRefreshError = true)
    {
        _isLoadingRecords = true;
        try
        {
            _attendanceDays = await AttendanceApi.GetAttendanceDaysAsync(from, to, developerId);
            if (applyFilters)
            {
                _appliedRecordsFrom = from;
                _appliedRecordsTo = to;
                _appliedRecordsDeveloperId = developerId;
                _appliedRecordsStatusFilter = statusFilter;
            }

            _hasLoadedRecords = true;
        }
        catch (Exception ex)
        {
            if (trackRefreshError)
            {
                NoteRefreshError(ex, notifyOnError);
            }
        }
        finally { _isLoadingRecords = false; }
    }

    private async Task RefreshAttendanceDaysIfLoadedAsync()
    {
        if (_hasLoadedRecords)
        {
            await LoadAttendanceDaysAsync(
                _appliedRecordsFrom,
                _appliedRecordsTo,
                _appliedRecordsDeveloperId,
                _appliedRecordsStatusFilter,
                applyFilters: false,
                notifyOnError: false);
        }
    }

    private async Task LoadPendingCorrectionCountsAsync(bool trackRefreshError = false)
    {
        var loadVersion = ++_pendingCountsLoadVersion;
        try
        {
            var counts = await AttendanceApi.GetPendingCorrectionCountsAsync();
            if (loadVersion != _pendingCountsLoadVersion)
            {
                return;
            }

            _pendingCorrectionCounts = counts;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            if (trackRefreshError && loadVersion == _pendingCountsLoadVersion)
            {
                NoteRefreshError(ex, notify: false);
            }
        }
    }

    private async Task SetRecordsRangePresetAsync(int fromOffsetDays, int toOffsetDays)
    {
        if (_isLoadingRecords)
        {
            return;
        }

        var today = GetOfficeToday();
        _recordsFrom = today.AddDays(fromOffsetDays);
        _recordsTo = today.AddDays(toOffsetDays);
        await LoadAttendanceDaysAsync();
    }

    private async Task OpenCorrectionModal()
    {
        _correctionDate = GetOfficeToday();
        await ShowCorrectionModalAsync();
    }

    private async Task ShowCorrectionModalAsync()
    {
        _showCorrectionModal = true;
        await CheckCorrectionPunchesAsync();
    }

    private async Task OpenCorrectionModalForDayAsync(AttendanceDayRowDto row)
    {
        _correctionDate = row.WorkDate;
        await ShowCorrectionModalAsync();
    }

    private void CloseCorrectionModal()
    {
        if (_isSubmittingCorrection)
        {
            return;
        }

        _correctionPunchCheckVersion++;
        _isCheckingCorrectionPunches = false;
        _showCorrectionModal = false;
    }

    private async Task CheckCorrectionPunchesAsync()
    {
        var date = _correctionDate;
        var checkVersion = ++_correctionPunchCheckVersion;

        _isCheckingCorrectionPunches = true;
        _hasCheckedCorrectionPunches = false;
        _canRequestPunchIn = false;
        _canRequestPunchOut = false;
        _requestPunchIn = false;
        _requestPunchOut = false;
        _correctionPunchCheckError = null;
        _correctionUnavailableMessage = null;

        try
        {
            if (_me.DeveloperId is null)
            {
                throw new InvalidOperationException("Your login is not linked to a developer profile.");
            }

            var details = await AttendanceApi.GetAttendanceDayDetailsAsync(_me.DeveloperId.Value, date);
            if (checkVersion != _correctionPunchCheckVersion || !_showCorrectionModal)
            {
                return;
            }

            if (details?.Row.HasPendingCorrection == true)
            {
                _correctionUnavailableMessage = "A pending correction request already exists for this date.";
            }
            else
            {
                _canRequestPunchIn = details?.Row.PunchInUtc is null;
                _canRequestPunchOut = details?.Row.PunchOutUtc is null;
            }

            _hasCheckedCorrectionPunches = true;
        }
        catch (Exception ex)
        {
            if (checkVersion == _correctionPunchCheckVersion && _showCorrectionModal)
            {
                _correctionPunchCheckError = $"Could not check existing punches. {ex.Message}";
            }
        }
        finally
        {
            if (checkVersion == _correctionPunchCheckVersion)
            {
                _isCheckingCorrectionPunches = false;
            }
        }
    }

    private async Task SubmitCorrectionAsync()
    {
        if (!_hasCheckedCorrectionPunches || _isCheckingCorrectionPunches)
        {
            return;
        }

        if (!_requestPunchIn && !_requestPunchOut)
        {
            Toast.Error("Select at least one punch to correct.", key: ToastKeys.AttendanceCorrectionSubmit);
            return;
        }

        if (string.IsNullOrWhiteSpace(_correctionReason))
        {
            Toast.Error("Reason is required.", key: ToastKeys.AttendanceCorrectionSubmit);
            return;
        }

        _isSubmittingCorrection = true;
        _refreshError = null;
        try
        {
            await AttendanceApi.SubmitCorrectionRequestAsync(new CreateAttendanceCorrectionRequest(
                _correctionDate,
                _requestPunchIn ? ToUtc(_correctionDate, _correctionPunchInTime) : null,
                _requestPunchOut ? ToUtc(_correctionDate, _correctionPunchOutTime) : null,
                _correctionReason));
            await Task.WhenAll(
                RefreshAttendanceDaysIfLoadedAsync(),
                LoadPendingCorrectionCountsAsync(trackRefreshError: true));

            _correctionReason = string.Empty;
            _showCorrectionModal = false;
            SetActionMessage("Correction request submitted.", ToastKeys.AttendanceCorrectionSubmit);
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message, key: ToastKeys.AttendanceCorrectionSubmit);
        }
        finally { _isSubmittingCorrection = false; }
    }

    private Task LoadAnalyticsAsync() => LoadAnalyticsAsync(notifyOnError: true);

    private async Task LoadAnalyticsAsync(bool notifyOnError)
    {
        _isLoadingAnalytics = true;
        try { _analytics = await AttendanceApi.GetAnalyticsAsync(_analyticsFrom, _analyticsTo); }
        catch (Exception ex) { NoteRefreshError(ex, notifyOnError); }
        finally { _isLoadingAnalytics = false; }
    }

    private async Task SetAnalyticsRangePresetAsync(int fromOffsetDays, int toOffsetDays)
    {
        if (_isLoadingAnalytics)
        {
            return;
        }

        var today = GetOfficeToday();
        _analyticsFrom = today.AddDays(fromOffsetDays);
        _analyticsTo = today.AddDays(toOffsetDays);
        await LoadAnalyticsAsync();
    }

    private async Task OpenDetailsAsync(AttendanceDayRowDto row)
    {
        var loadVersion = ++_detailsLoadVersion;
        _showDetailsModal = true;
        _isLoadingDetails = true;
        _detailsError = null;
        _attendanceDetails = null;

        try
        {
            var details = await AttendanceApi.GetAttendanceDayDetailsAsync(row.DeveloperId, row.WorkDate);
            if (loadVersion == _detailsLoadVersion && _showDetailsModal)
            {
                _attendanceDetails = details;
            }
        }
        catch (Exception ex)
        {
            if (loadVersion == _detailsLoadVersion && _showDetailsModal)
            {
                _detailsError = ex.Message;
            }
        }
        finally
        {
            if (loadVersion == _detailsLoadVersion)
            {
                _isLoadingDetails = false;
            }
        }
    }

    private void CloseDetails()
    {
        _detailsLoadVersion++;
        _showDetailsModal = false;
        _isLoadingDetails = false;
        _attendanceDetails = null;
        _detailsError = null;
    }

    private bool CanRequestCorrection(AttendanceDayRowDto row)
    {
        var today = GetOfficeToday();
        return row.DeveloperId == _me.DeveloperId
            && !row.HasPendingCorrection
            && (row.PunchInUtc is null || row.PunchOutUtc is null)
            && row.WorkDate <= today
            && today.DayNumber - row.WorkDate.DayNumber <= 30;
    }

    // Cancellation remains ownership-scoped, including for administrators.
    private bool CanCancelCorrection(AttendanceDayRowDto row) =>
        row.HasPendingCorrection && row.DeveloperId == _me.DeveloperId;

    private void OpenReviewModal(Guid id, bool approve)
    {
        _reviewCorrectionId = id;
        _reviewIsApprove = approve;
        _reviewComment = string.Empty;
        _reviewError = null;
        _showReviewModal = true;
    }

    private void CloseReviewModal()
    {
        if (_isReviewingCorrection)
        {
            return;
        }

        _showReviewModal = false;
        _reviewError = null;
    }

    private async Task SubmitReviewAsync()
    {
        if (_reviewCorrectionId is null)
        {
            return;
        }

        _isReviewingCorrection = true;
        _reviewError = null;
        _refreshError = null;
        var comment = string.IsNullOrWhiteSpace(_reviewComment) ? null : _reviewComment.Trim();

        try
        {
            var successMessage = "Correction request rejected.";
            if (_reviewIsApprove)
            {
                await AttendanceApi.ApproveCorrectionRequestAsync(
                    _reviewCorrectionId.Value,
                    new ReviewAttendanceCorrectionRequest(null, null, comment));
                successMessage = "Correction request approved.";
            }
            else
            {
                await AttendanceApi.RejectCorrectionRequestAsync(
                    _reviewCorrectionId.Value,
                    new RejectAttendanceCorrectionRequest(comment));
            }

            await RefreshAfterCorrectionReviewAsync(_reviewIsApprove);
            SetActionMessage(successMessage);

            _showReviewModal = false;
            _reviewCorrectionId = null;
            _reviewComment = string.Empty;
        }
        catch (Exception ex)
        {
            _reviewError = ex.Message;
        }
        finally
        {
            _isReviewingCorrection = false;
        }
    }

    private async Task RefreshAfterCorrectionReviewAsync(bool wasApproved)
    {
        await Task.WhenAll(
            RefreshAttendanceDaysIfLoadedAsync(),
            LoadPendingCorrectionCountsAsync(trackRefreshError: true));

        if (wasApproved)
        {
            await RefreshMeBestEffortAsync();
            if (_analytics is not null)
            {
                await LoadAnalyticsAsync(notifyOnError: false);
            }
        }
    }

    private async Task CancelCorrectionAsync(Guid id)
    {
        _refreshError = null;
        try
        {
            await AttendanceApi.CancelCorrectionRequestAsync(id);
            await Task.WhenAll(
                RefreshAttendanceDaysIfLoadedAsync(),
                LoadPendingCorrectionCountsAsync(trackRefreshError: true));
            SetActionMessage("Correction request cancelled.");
        }
        catch (Exception ex) { Toast.Error(ex.Message, key: ToastKeys.Attendance); }
    }

    private async Task AdminQuickFixAsync(AttendanceDayRowDto row)
    {
        _refreshError = null;
        try
        {
            await AttendanceApi.AdminUpsertRecordAsync(row.DeveloperId, row.WorkDate,
                new AdminUpsertAttendanceRecordRequest(
                    row.PunchInUtc ?? ToUtc(row.WorkDate, new TimeOnly(9, 0)),
                    row.PunchOutUtc ?? ToUtc(row.WorkDate, new TimeOnly(18, 0))));
            await RefreshMeBestEffortAsync();
            await RefreshAttendanceDaysIfLoadedAsync();
            if (_analytics is not null)
            {
                await LoadAnalyticsAsync(notifyOnError: false);
            }
            SetActionMessage("Attendance record updated.");
        }
        catch (Exception ex) { Toast.Error(ex.Message, key: ToastKeys.Attendance); }
    }

    private async Task SetTabAsync(AttendanceTab tab)
    {
        _tab = tab;
        if (tab == AttendanceTab.Records)
        {
            if (_recordsPrefetchTask is { } prefetchTask)
            {
                await prefetchTask;
                if (ReferenceEquals(_recordsPrefetchTask, prefetchTask))
                {
                    _recordsPrefetchTask = null;
                }
            }

            if (!_hasLoadedRecords && !_isLoadingRecords)
            {
                await LoadAttendanceDaysAsync();
            }
            else
            {
                _ = LoadPendingCorrectionCountsAsync();
            }
        }
        else if (tab == AttendanceTab.AdminAnalytics && _analytics is null && !_isLoadingAnalytics)
        {
            await LoadAnalyticsAsync();
        }
    }

    private IReadOnlyList<AttendanceDayRowDto> GetFilteredAttendanceDays()
    {
        return _appliedRecordsStatusFilter == AttendanceRowStatusFilter.All
            ? _attendanceDays
            : _attendanceDays.Where(MatchesStatusFilter).ToList();
    }

    private bool MatchesStatusFilter(AttendanceDayRowDto row)
    {
        if (row.HasPendingCorrection)
        {
            return _appliedRecordsStatusFilter == AttendanceRowStatusFilter.Pending;
        }

        return _appliedRecordsStatusFilter switch
        {
            AttendanceRowStatusFilter.NoRecord => row.RecordStatus is null,
            AttendanceRowStatusFilter.OnTime => row.RecordStatus == AttendanceDayStatusDto.OnTime,
            AttendanceRowStatusFilter.Late => row.RecordStatus == AttendanceDayStatusDto.Late,
            AttendanceRowStatusFilter.EarlyLeave => row.RecordStatus == AttendanceDayStatusDto.EarlyLeave,
            AttendanceRowStatusFilter.Incomplete => row.RecordStatus == AttendanceDayStatusDto.Incomplete,
            AttendanceRowStatusFilter.Absent => row.RecordStatus == AttendanceDayStatusDto.Absent,
            _ => false
        };
    }

    private static string DetailsStatusLabel(AttendanceDayRowDto row) =>
        row.RecordStatus is null ? "No record" : AttendanceFormatter.DayStatusLabel(row.RecordStatus.Value);

    private static string DetailsStatusClass(AttendanceDayRowDto row) =>
        row.RecordStatus is null ? "absent" : AttendanceFormatter.DayStatusClass(row.RecordStatus.Value);

    private string GetPunchHint() => _me.NextAction switch
    {
        AttendanceNextActionDto.PunchIn when !IsPunchInAllowed() => GetPunchInLockedHint(),
        AttendanceNextActionDto.PunchIn => "Press and hold the fingerprint for about one second.",
        AttendanceNextActionDto.PunchOut when !IsPunchOutAllowed() => GetPunchOutLockedHint(),
        AttendanceNextActionDto.PunchOut => $"Hold again when you are ready to leave. Punch out closes at {FormatPunchTime(_me.PunchOutLatestTime)}.",
        AttendanceNextActionDto.Complete => "You have already punched in and out today.",
        _ => string.Empty
    };

    private string GetTimeZoneLabel()
    {
        try
        {
            var tz = TimeZoneInfo.FindSystemTimeZoneById(_me.OfficeTimeZoneId);
            return tz.IsDaylightSavingTime(DateTime.UtcNow)
                ? tz.DaylightName
                : tz.StandardName;
        }
        catch
        {
            return _me.OfficeTimeZoneId;
        }
    }

    private DateOnly GetOfficeToday()
    {
        try
        {
            var tz = TimeZoneInfo.FindSystemTimeZoneById(_me.OfficeTimeZoneId);
            return DateOnly.FromDateTime(TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, tz));
        }
        catch { return DateOnly.FromDateTime(DateTime.Today); }
    }

    private DateTime? ToUtc(DateOnly date, TimeOnly time)
    {
        try
        {
            var tz = TimeZoneInfo.FindSystemTimeZoneById(_me.OfficeTimeZoneId);
            return TimeZoneInfo.ConvertTimeToUtc(DateTime.SpecifyKind(date.ToDateTime(time), DateTimeKind.Unspecified), tz);
        }
        catch { return date.ToDateTime(time).ToUniversalTime(); }
    }

    private string GetPunchInLockedHint()
    {
        var currentTime = GetOfficeCurrentTime();
        if (currentTime is not null
            && _me.PunchInLatestTime is not null
            && currentTime > _me.PunchInLatestTime.Value)
        {
            return $"Punch in closed at {FormatPunchTime(_me.PunchInLatestTime)}. Submit an attendance correction if needed.";
        }

        return $"Punch in opens at {FormatPunchTime(_me.PunchInEarliestTime)}.";
    }

    private string GetPunchOutLockedHint()
    {
        var currentTime = GetOfficeCurrentTime();
        if (currentTime is not null
            && _me.PunchOutLatestTime is not null
            && currentTime > _me.PunchOutLatestTime.Value)
        {
            return $"Punch out closed at {FormatPunchTime(_me.PunchOutLatestTime)}.";
        }

        return $"Punch out is available after {FormatPunchTime(_me.PunchOutEarliestTime)} until {FormatPunchTime(_me.PunchOutLatestTime)}.";
    }

    public void Dispose()
    {
        _punchWindowTimer?.Dispose();
        _meRefreshTimer?.Dispose();
        _correctionPunchCheckVersion++;
        _pendingCountsLoadVersion++;
    }
}
