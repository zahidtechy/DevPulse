@page "/holidays"
@attribute [Authorize]
@implements IAsyncDisposable
@inject IHolidayApiClient HolidayApi
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject ToastService Toast

<PageTitle>@AppBranding.PageTitle("Holiday Calendar")</PageTitle>

<div class="holiday-page">
    <div class="analytics-hero analytics-hero-compact holiday-hero">
        <div class="analytics-hero-copy">
            <p class="analytics-eyebrow">Company · Time Off</p>
            <h1>Holiday Calendar</h1>
            <p class="analytics-lead">
                Plan around company-wide days off. Browse the year at a glance or click a highlighted date to jump to its details.
            </p>
        </div>
        <AuthorizeView Roles="@AppRoles.Admin">
            <Authorized>
                @if (!_showForm)
                {
                    <div class="analytics-hero-actions">
                        <BusyButton CssClass="btn btn-outline-light btn-sm"
                                    IsBusy="_isFetchingGoogleHolidays"
                                    Disabled="_isImportingGoogleHolidays"
                                    BusyText="Fetching..."
                                    OnClick="FetchGoogleHolidaysAsync">
                            <span class="bi-cloud-download holiday-btn-icon" aria-hidden="true"></span>
                            Fetch from Google
                        </BusyButton>
                        <button class="btn btn-outline-light btn-sm" @onclick="ShowAddForm">
                            <span class="bi-calendar-plus holiday-btn-icon" aria-hidden="true"></span>
                            Add Holiday
                        </button>
                    </div>
                }
            </Authorized>
        </AuthorizeView>
    </div>

    @if (_isLoading)
    {
        <LoadingIndicator Text="Loading holidays..." />
    }
    else
    {
        <div class="holiday-stats">
            <div class="holiday-stat-card holiday-stat-card-holidays">
                <span class="holiday-stat-icon bi-calendar-event" aria-hidden="true"></span>
                <span class="holiday-stat-label">Holidays</span>
                <span class="holiday-stat-value">@_holidays.Count</span>
            </div>
            <div class="holiday-stat-card holiday-stat-card-days">
                <span class="holiday-stat-icon bi-sun" aria-hidden="true"></span>
                <span class="holiday-stat-label">Days off</span>
                <span class="holiday-stat-value">@GetTotalDaysOff()</span>
            </div>
            <div class="holiday-stat-card holiday-stat-card-wide holiday-stat-card-next">
                <span class="holiday-stat-icon bi-arrow-right-circle" aria-hidden="true"></span>
                <span class="holiday-stat-label">Next holiday</span>
                <span class="holiday-stat-value holiday-stat-value-text">@GetNextHolidayLabel()</span>
            </div>
        </div>

        <div class="filter-card card mb-4 holiday-nav-card">
            <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="holiday-toolbar">
                    <div class="holiday-year-nav">
                        <button type="button" class="holiday-year-btn" @onclick="PreviousYearAsync" aria-label="Previous year">
                            <span class="bi-chevron-left" aria-hidden="true"></span>
                        </button>
                        <span class="holiday-year-label">@SelectedYear</span>
                        <button type="button" class="holiday-year-btn" @onclick="NextYearAsync" aria-label="Next year">
                            <span class="bi-chevron-right" aria-hidden="true"></span>
                        </button>
                    </div>
                    <button type="button"
                            class="period-chip @(_selectedYear == DateTime.Today.Year ? "active" : null)"
                            @onclick="GoToCurrentYearAsync">
                        This year
                    </button>
                </div>
                <div class="holiday-legend" aria-label="Calendar legend">
                    <span class="holiday-legend-item"><span class="holiday-legend-swatch holiday-legend-holiday"></span> Holiday</span>
                    <span class="holiday-legend-item"><span class="holiday-legend-swatch holiday-legend-today"></span> Today</span>
                    <span class="holiday-legend-item"><span class="holiday-legend-swatch holiday-legend-selected"></span> Selected</span>
                </div>
            </div>
        </div>

        <div class="holiday-layout">
            <div class="holiday-calendar-panel">
                @foreach (var quarter in GetQuarters())
                {
                    <section class="holiday-quarter @GetQuarterClass(quarter.Label)">
                        <div class="holiday-quarter-header">
                            <div class="holiday-quarter-heading">
                                <h2 class="holiday-quarter-title">@quarter.Label</h2>
                                <span class="holiday-quarter-meta">@quarter.MonthRange</span>
                            </div>
                            <span class="holiday-quarter-count">@GetQuarterHolidayCount(quarter.Months) holiday@(GetQuarterHolidayCount(quarter.Months) == 1 ? "" : "s")</span>
                        </div>
                        <div class="holiday-quarter-grid">
                            @foreach (var month in quarter.Months)
                            {
                                <MonthCalendar Year="SelectedYear"
                                               Id="@GetHolidayMonthId(month)"
                                               Month="month"
                                               Holidays="_holidays"
                                               Today="_today"
                                               SelectedHolidayId="_highlightedHolidayId"
                                               OnHolidaySelected="SelectHolidayFromCalendarAsync" />
                            }
                        </div>
                    </section>
                }
            </div>

            <aside class="holiday-list-panel data-card card">
                <div class="holiday-list-header">
                    <div class="holiday-list-header-icon" aria-hidden="true">
                        <span class="bi-calendar3"></span>
                    </div>
                    <div>
                        <h5 class="holiday-list-title mb-0">@SelectedYear Schedule</h5>
                        <p class="holiday-list-subtitle mb-0">@_holidays.Count scheduled · @GetTotalDaysOff() days off</p>
                    </div>
                </div>
                <div class="holiday-list-scroll">
                    @if (_holidays.Count == 0)
                    {
                        <div class="holiday-empty-state">
                            <div class="holiday-empty-icon" aria-hidden="true">
                                <span class="bi-calendar-x"></span>
                            </div>
                            <p class="mb-0 fw-semibold">No holidays scheduled</p>
                            <p class="text-muted small mb-0 mt-1">There are no company holidays for @SelectedYear.</p>
                            <AuthorizeView Roles="@AppRoles.Admin">
                                <Authorized>
                                    <button type="button" class="btn btn-primary btn-sm mt-3" @onclick="ShowAddForm">Add first holiday</button>
                                </Authorized>
                            </AuthorizeView>
                        </div>
                    }
                    else
                    {
                        @foreach (var group in GetHolidayGroups())
                        {
                            <div class="holiday-list-group">
                                <div class="holiday-list-group-title">@group.MonthName</div>
                                @foreach (var holiday in group.Holidays)
                                {
                                    <div id="@GetHolidayListItemId(holiday.Id)"
                                         class="holiday-list-item @GetHolidayListItemClass(holiday.Id)"
                                         role="button"
                                         tabindex="0"
                                         @onclick="() => SelectHolidayInCalendarAsync(holiday, group.Month)"
                                         @onkeydown="e => HandleListItemKeyDownAsync(e, holiday, group.Month)">
                                        <div class="holiday-list-date-badge">
                                            @if (holiday.FromDate == holiday.ToDate || holiday.FromDate.Month == holiday.ToDate.Month)
                                            {
                                                <span class="holiday-list-date-month">@holiday.FromDate.ToString("MMM").ToUpperInvariant()</span>
                                                <span class="holiday-list-date-day">@FormatDateBadge(holiday)</span>
                                            }
                                            else
                                            {
                                                <span class="holiday-list-date-span">@FormatDateBadge(holiday)</span>
                                            }
                                        </div>
                                        <div class="holiday-list-item-main">
                                            <div class="holiday-list-name-row">
                                                <div class="holiday-list-name">@holiday.Name</div>
                                                <AuthorizeView Roles="@AppRoles.Admin">
                                                    <Authorized>
                                                        <div class="holiday-list-actions"
                                                             @onclick:stopPropagation="true"
                                                             @onkeydown:stopPropagation="true">
                                                            <button type="button"
                                                                    class="btn btn-outline-primary btn-sm holiday-list-action-btn"
                                                                    disabled="@_isBusy"
                                                                    title="@($"Edit {holiday.Name}")"
                                                                    aria-label="@($"Edit {holiday.Name}")"
                                                                    @onclick="() => EditHolidayAsync(holiday)">
                                                                <span class="bi-pencil-square" aria-hidden="true"></span>
                                                            </button>
                                                            <button type="button"
                                                                    class="btn btn-outline-danger btn-sm holiday-list-action-btn"
                                                                    disabled="@_isBusy"
                                                                    title="@($"Delete {holiday.Name}")"
                                                                    aria-label="@($"Delete {holiday.Name}")"
                                                                    @onclick="() => DeleteHolidayAsync(holiday)">
                                                                <span class="bi-trash" aria-hidden="true"></span>
                                                            </button>
                                                        </div>
                                                    </Authorized>
                                                </AuthorizeView>
                                            </div>
                                            <div class="holiday-list-meta">
                                                <div class="holiday-list-range">@FormatDateRange(holiday)</div>
                                                <span class="holiday-duration-chip">@GetDurationDays(holiday) day@(GetDurationDays(holiday) == 1 ? "" : "s")</span>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(holiday.Reason))
                                            {
                                                <div class="holiday-list-reason">@holiday.Reason</div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            </aside>
        </div>
    }
</div>

<AuthorizeView Roles="@AppRoles.Admin">
    <Authorized>
        <ModalDialog IsVisible="_showForm"
                     Title="@(_editingHolidayId.HasValue ? "Edit Holiday" : "Add Holiday")"
                     IsBusy="_isBusy"
                     OnClose="HideForm">
            <ChildContent>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label" for="holidayFromDate">From date</label>
                        <DateInput Id="holidayFromDate"
                                   @bind-Value="_fromDate"
                                   DefaultValue="@DefaultFromDate"
                                   Disabled="@_isBusy" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="holidayToDate">To date</label>
                        <DateInput Id="holidayToDate"
                                   @bind-Value="_toDate"
                                   DefaultValue="@DefaultToDate"
                                   Disabled="@_isBusy" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="holidayName">Name</label>
                        <input id="holidayName"
                               class="form-control"
                               disabled="@_isBusy"
                               @bind="_name"
                               placeholder="Independence Day" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="holidayReason">Reason <span class="text-muted">(optional)</span></label>
                        <input id="holidayReason"
                               class="form-control"
                               disabled="@_isBusy"
                               @bind="_reason"
                               placeholder="National holiday" />
                    </div>
                </div>
            </ChildContent>
            <FooterContent>
                <button type="button" class="btn btn-outline-secondary" disabled="@_isBusy" @onclick="HideForm">Cancel</button>
                <BusyButton CssClass="btn btn-primary" IsBusy="_isBusy" BusyText="Saving..." OnClick="SaveHolidayAsync">
                    @(_editingHolidayId.HasValue ? "Update Holiday" : "Create Holiday")
                </BusyButton>
            </FooterContent>
        </ModalDialog>

        <ModalDialog IsVisible="@(_googleHolidayPreview is not null)"
                     Title="Bangladesh holidays from Google"
                     IsBusy="@IsGoogleHolidayBusy"
                     CloseOnBackdropClick="true"
                     OnClose="CloseGoogleHolidayPreview">
            <ChildContent>
                @if (_googleHolidayPreview is not null)
                {
                    <div class="google-holiday-preview-summary">
                        <div>
                            <div class="google-holiday-preview-heading">@_googleHolidayPreview.Year public holidays</div>
                            <div class="text-muted small">
                                Fetched from Google's official Bangladesh holiday calendar.
                            </div>
                        </div>
                        <div class="google-holiday-preview-counts" aria-label="Import summary">
                            <span class="badge text-bg-success">@GetGoogleHolidayCount(GoogleHolidayImportStatusDto.New) new</span>
                            <span class="badge text-bg-secondary">@GetGoogleHolidayCount(GoogleHolidayImportStatusDto.AlreadyExists) existing</span>
                            <span class="badge text-bg-warning">@GetGoogleHolidayCount(GoogleHolidayImportStatusDto.Overlap) overlapping</span>
                        </div>
                    </div>

                    <div class="alert alert-info google-holiday-import-note" role="status">
                        <span class="bi-shield-check" aria-hidden="true"></span>
                        <span>
                            Import is insert-only. Existing holidays are never overwritten. Entries that already exist or overlap an existing date cannot be selected.
                        </span>
                    </div>

                    @if (_googleHolidayPreview.Holidays.Count == 0)
                    {
                        <div class="holiday-empty-state google-holiday-empty">
                            <div class="holiday-empty-icon" aria-hidden="true">
                                <span class="bi-cloud-slash"></span>
                            </div>
                            <p class="mb-0 fw-semibold">No Google holidays found</p>
                            <p class="text-muted small mb-0 mt-1">Google did not return public holidays for @_googleHolidayPreview.Year.</p>
                        </div>
                    }
                    else
                    {
                        <div class="google-holiday-select-all">
                            <label class="form-check mb-0">
                                <input class="form-check-input"
                                       type="checkbox"
                                       checked="@AreAllGoogleHolidaysSelected()"
                                       disabled="@(IsGoogleHolidayBusy || GetImportableGoogleHolidayCount() == 0)"
                                       @onchange="ToggleAllGoogleHolidays" />
                                <span class="form-check-label">Select all new holidays</span>
                            </label>
                            <span class="text-muted small">@GetSelectedGoogleHolidayCount() selected</span>
                        </div>

                        <div class="table-responsive google-holiday-preview-table-wrap">
                            <table class="table table-hover align-middle mb-0 google-holiday-preview-table">
                                <thead>
                                    <tr>
                                        <th class="google-holiday-select-column"><span class="visually-hidden">Select</span></th>
                                        <th>Date</th>
                                        <th>Holiday</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in _googleHolidayPreview.Holidays)
                                    {
                                        var canImport = item.Status == GoogleHolidayImportStatusDto.New;
                                        <tr class="@GetGoogleHolidayRowClass(item.Status)">
                                            <td class="google-holiday-select-column">
                                                <input class="form-check-input"
                                                       type="checkbox"
                                                       aria-label="@($"Select {item.Holiday.Name}")"
                                                       checked="@_selectedGoogleHolidayKeys.Contains(item.Holiday.Key)"
                                                       disabled="@(!canImport || IsGoogleHolidayBusy)"
                                                       @onchange="args => ToggleGoogleHoliday(item.Holiday.Key, args)" />
                                            </td>
                                            <td class="google-holiday-date">@FormatGoogleHolidayRange(item.Holiday)</td>
                                            <td>
                                                <div class="fw-semibold">@item.Holiday.Name</div>
                                                @if (!string.IsNullOrWhiteSpace(item.Holiday.Reason))
                                                {
                                                    <div class="text-muted small">@item.Holiday.Reason</div>
                                                }
                                                @if (item.OverlappingHolidays.Count > 0)
                                                {
                                                    <div class="google-holiday-conflict small">
                                                        Existing: @string.Join(", ", item.OverlappingHolidays.Select(FormatExistingHolidayConflict))
                                                    </div>
                                                }
                                            </td>
                                            <td>
                                                <span class="badge @GetGoogleHolidayStatusClass(item.Status)">
                                                    @GetGoogleHolidayStatusLabel(item.Status)
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
            </ChildContent>
            <FooterContent>
                <button type="button"
                        class="btn btn-outline-secondary"
                        disabled="@IsGoogleHolidayBusy"
                        @onclick="CloseGoogleHolidayPreview">
                    Close
                </button>
                <BusyButton CssClass="btn btn-primary"
                            IsBusy="_isImportingGoogleHolidays"
                            Disabled="@(GetSelectedGoogleHolidayCount() == 0 || _isFetchingGoogleHolidays)"
                            BusyText="Importing..."
                            OnClick="ImportGoogleHolidaysAsync">
                    Import selected (@GetSelectedGoogleHolidayCount())
                </BusyButton>
            </FooterContent>
        </ModalDialog>
    </Authorized>
</AuthorizeView>

@code {
    private readonly List<HolidayDto> _holidays = [];
    private readonly DateOnly _today = DateOnly.FromDateTime(DateTime.Today);

    private int _selectedYear = DateTime.Today.Year;
    private bool _isLoading = true;
    private bool _isBusy;
    private bool _isAdmin;
    private bool _showForm;
    private bool _isFetchingGoogleHolidays;
    private bool _isImportingGoogleHolidays;
    private Guid? _editingHolidayId;
    private Guid? _highlightedHolidayId;
    private GoogleHolidayPreviewDto? _googleHolidayPreview;
    private readonly HashSet<string> _selectedGoogleHolidayKeys = new(StringComparer.Ordinal);
    private IJSObjectReference? _holidayCalendarModule;

    private DateTime _fromDate;
    private DateTime _toDate;

    // Single definition of the range default: used on first open and when a date
    // field is cleared, so the two can never drift apart.
    private DateTime DefaultFromDate => DateTime.Today;

    private DateTime DefaultToDate => DateTime.Today;
    private string _name = string.Empty;
    private string? _reason;

    private int SelectedYear => _selectedYear;

    private bool IsGoogleHolidayBusy => _isFetchingGoogleHolidays || _isImportingGoogleHolidays;

    protected override async Task OnInitializedAsync()
    {
        _fromDate = DefaultFromDate;
        _toDate = DefaultToDate;
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _isAdmin = authState.User.IsInRole(AppRoles.Admin);
        await LoadHolidaysAsync();
    }

    private async Task LoadHolidaysAsync()
    {
        _isLoading = true;

        try
        {
            var holidays = await HolidayApi.GetByYearAsync(_selectedYear);
            _holidays.Clear();
            _holidays.AddRange(holidays);
            _highlightedHolidayId = null;
        }
        catch (Exception ex)
        {
            Toast.Error($"Failed to load holidays: {ex.Message}", key: ToastKeys.Holidays);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task PreviousYearAsync()
    {
        _selectedYear--;
        await LoadHolidaysAsync();
    }

    private async Task NextYearAsync()
    {
        _selectedYear++;
        await LoadHolidaysAsync();
    }

    private async Task GoToCurrentYearAsync()
    {
        _selectedYear = DateTime.Today.Year;
        await LoadHolidaysAsync();
    }

    private async Task FetchGoogleHolidaysAsync()
    {
        if (!_isAdmin || IsGoogleHolidayBusy)
        {
            return;
        }

        _isFetchingGoogleHolidays = true;
        try
        {
            _googleHolidayPreview = await HolidayApi.PreviewGoogleHolidaysAsync(_selectedYear);
            SelectAllImportableGoogleHolidays();
        }
        catch (Exception ex)
        {
            Toast.Error(ExtractErrorMessage(ex.Message), key: ToastKeys.Holidays);
        }
        finally
        {
            _isFetchingGoogleHolidays = false;
        }
    }

    private async Task ImportGoogleHolidaysAsync()
    {
        if (!_isAdmin || _googleHolidayPreview is null || _selectedGoogleHolidayKeys.Count == 0 || IsGoogleHolidayBusy)
        {
            return;
        }

        _isImportingGoogleHolidays = true;
        try
        {
            var request = new ImportGoogleHolidaysRequest(
                _googleHolidayPreview.Year,
                _selectedGoogleHolidayKeys.Order(StringComparer.Ordinal).ToList());
            var result = await HolidayApi.ImportGoogleHolidaysAsync(request);

            _googleHolidayPreview = result.Preview;
            _selectedGoogleHolidayKeys.Clear();
            await LoadHolidaysAsync();

            if (result.SkippedCount > 0)
            {
                Toast.Warning($"Imported {result.ImportedCount} holiday(s); skipped {result.SkippedCount} because their dates now overlap existing holidays.", key: ToastKeys.Holidays);
            }
            else
            {
                Toast.Success($"Imported {result.ImportedCount} Bangladesh holiday(s) from Google.", key: ToastKeys.Holidays);
            }
        }
        catch (Exception ex)
        {
            Toast.Error(ExtractErrorMessage(ex.Message), key: ToastKeys.Holidays);
        }
        finally
        {
            _isImportingGoogleHolidays = false;
        }
    }

    private void CloseGoogleHolidayPreview()
    {
        if (IsGoogleHolidayBusy)
        {
            return;
        }

        _googleHolidayPreview = null;
        _selectedGoogleHolidayKeys.Clear();
    }

    private void ToggleGoogleHoliday(string key, ChangeEventArgs args)
    {
        if (args.Value is bool isSelected && isSelected)
        {
            if (_googleHolidayPreview?.Holidays.Any(item =>
                    item.Holiday.Key == key && item.Status == GoogleHolidayImportStatusDto.New) == true)
            {
                _selectedGoogleHolidayKeys.Add(key);
            }
        }
        else
        {
            _selectedGoogleHolidayKeys.Remove(key);
        }
    }

    private void ToggleAllGoogleHolidays(ChangeEventArgs args)
    {
        if (args.Value is bool isSelected && isSelected)
        {
            SelectAllImportableGoogleHolidays();
        }
        else
        {
            _selectedGoogleHolidayKeys.Clear();
        }
    }

    private void SelectAllImportableGoogleHolidays()
    {
        _selectedGoogleHolidayKeys.Clear();
        if (_googleHolidayPreview is null)
        {
            return;
        }

        foreach (var item in _googleHolidayPreview.Holidays.Where(item => item.Status == GoogleHolidayImportStatusDto.New))
        {
            _selectedGoogleHolidayKeys.Add(item.Holiday.Key);
        }
    }

    private bool AreAllGoogleHolidaysSelected()
    {
        if (_googleHolidayPreview is null)
        {
            return false;
        }

        var importableKeys = _googleHolidayPreview.Holidays
            .Where(item => item.Status == GoogleHolidayImportStatusDto.New)
            .Select(item => item.Holiday.Key)
            .ToList();
        return importableKeys.Count > 0 && importableKeys.All(_selectedGoogleHolidayKeys.Contains);
    }

    private int GetSelectedGoogleHolidayCount() => _selectedGoogleHolidayKeys.Count;

    private int GetImportableGoogleHolidayCount() =>
        _googleHolidayPreview?.Holidays.Count(item => item.Status == GoogleHolidayImportStatusDto.New) ?? 0;

    private int GetGoogleHolidayCount(GoogleHolidayImportStatusDto status) =>
        _googleHolidayPreview?.Holidays.Count(item => item.Status == status) ?? 0;

    private static string GetGoogleHolidayStatusLabel(GoogleHolidayImportStatusDto status) => status switch
    {
        GoogleHolidayImportStatusDto.New => "New",
        GoogleHolidayImportStatusDto.AlreadyExists => "Already exists",
        _ => "Overlaps existing"
    };

    private static string GetGoogleHolidayStatusClass(GoogleHolidayImportStatusDto status) => status switch
    {
        GoogleHolidayImportStatusDto.New => "text-bg-success",
        GoogleHolidayImportStatusDto.AlreadyExists => "text-bg-secondary",
        _ => "text-bg-warning"
    };

    private static string? GetGoogleHolidayRowClass(GoogleHolidayImportStatusDto status) => status switch
    {
        GoogleHolidayImportStatusDto.AlreadyExists => "google-holiday-row-existing",
        GoogleHolidayImportStatusDto.Overlap => "google-holiday-row-overlap",
        _ => null
    };

    private static string FormatGoogleHolidayRange(GoogleHolidayDto holiday) =>
        holiday.FromDate == holiday.ToDate
            ? holiday.FromDate.ToString("d MMM yyyy")
            : $"{holiday.FromDate:d MMM} – {holiday.ToDate:d MMM yyyy}";

    private static string FormatExistingHolidayConflict(HolidayDto holiday) =>
        holiday.FromDate == holiday.ToDate
            ? $"{holiday.Name} ({holiday.FromDate:d MMM})"
            : $"{holiday.Name} ({holiday.FromDate:d MMM}–{holiday.ToDate:d MMM})";

    private void ShowAddForm()
    {
        _editingHolidayId = null;
        _fromDate = DefaultFromDate;
        _toDate = DefaultToDate;
        _name = string.Empty;
        _reason = null;
        _showForm = true;
    }

    private async Task SelectHolidayFromCalendarAsync(HolidayDto holiday)
    {
        _highlightedHolidayId = holiday.Id;
        await ScrollToHolidayListItemAsync(holiday.Id);
    }

    private async Task SelectHolidayInCalendarAsync(HolidayDto holiday, int month)
    {
        _highlightedHolidayId = holiday.Id;
        await ScrollToHolidayMonthAsync(month);
    }

    private async Task ScrollToHolidayListItemAsync(Guid holidayId)
    {
        await ScrollToElementAsync(GetHolidayListItemId(holidayId), "nearest");
    }

    private async Task ScrollToHolidayMonthAsync(int month)
    {
        await ScrollToElementAsync(GetHolidayMonthId(month), "center");
    }

    private async Task ScrollToElementAsync(string elementId, string block)
    {
        try
        {
            _holidayCalendarModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/holidayCalendar.js");
            await _holidayCalendarModule.InvokeVoidAsync("scrollToElement", elementId, block);
        }
        catch
        {
            // Selection still works when scrolling is unavailable.
        }
    }

    private async Task HandleListItemKeyDownAsync(KeyboardEventArgs args, HolidayDto holiday, int month)
    {
        if (args.Key is "Enter" or " ")
        {
            await SelectHolidayInCalendarAsync(holiday, month);
        }
    }

    private static string GetHolidayListItemId(Guid holidayId) => $"holiday-item-{holidayId}";

    private string GetHolidayMonthId(int month) => $"holiday-month-{SelectedYear}-{month:D2}";

    private string? GetHolidayListItemClass(Guid holidayId)
    {
        return _highlightedHolidayId == holidayId
            ? "holiday-list-item-selected"
            : null;
    }

    private void EditHolidayAsync(HolidayDto holiday)
    {
        _highlightedHolidayId = holiday.Id;
        _editingHolidayId = holiday.Id;
        _fromDate = holiday.FromDate.ToDateTime(TimeOnly.MinValue);
        _toDate = holiday.ToDate.ToDateTime(TimeOnly.MinValue);
        _name = holiday.Name;
        _reason = holiday.Reason;
        _showForm = true;
    }

    private void HideForm()
    {
        _showForm = false;
        _editingHolidayId = null;
    }

    private async Task SaveHolidayAsync()
    {
        _isBusy = true;

        try
        {
            if (_fromDate.Date > _toDate.Date)
            {
                Toast.Warning("To date must be on or after from date.", key: ToastKeys.Holidays);
                return;
            }

            if (string.IsNullOrWhiteSpace(_name))
            {
                Toast.Warning("Holiday name is required.", key: ToastKeys.Holidays);
                return;
            }

            var fromDate = DateOnly.FromDateTime(_fromDate);
            var toDate = DateOnly.FromDateTime(_toDate);

            if (_editingHolidayId.HasValue)
            {
                await HolidayApi.UpdateAsync(
                    _editingHolidayId.Value,
                    new UpdateHolidayRequest(fromDate, toDate, _name.Trim(), string.IsNullOrWhiteSpace(_reason) ? null : _reason.Trim()));
                Toast.Success("Holiday updated successfully.", key: ToastKeys.Holidays);
            }
            else
            {
                await HolidayApi.CreateAsync(
                    new CreateHolidayRequest(fromDate, toDate, _name.Trim(), string.IsNullOrWhiteSpace(_reason) ? null : _reason.Trim()));
                Toast.Success("Holiday created successfully.", key: ToastKeys.Holidays);
            }

            HideForm();
            await LoadHolidaysAsync();
        }
        catch (Exception ex)
        {
            Toast.Error(ExtractErrorMessage(ex.Message), key: ToastKeys.Holidays);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task DeleteHolidayAsync(HolidayDto holiday)
    {
        _isBusy = true;

        try
        {
            await HolidayApi.DeleteAsync(holiday.Id);
            Toast.Success($"Deleted \"{holiday.Name}\".", key: ToastKeys.Holidays);

            if (_editingHolidayId == holiday.Id)
            {
                HideForm();
            }

            await LoadHolidaysAsync();
        }
        catch (Exception ex)
        {
            Toast.Error(ExtractErrorMessage(ex.Message), key: ToastKeys.Holidays);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private IEnumerable<HolidayGroup> GetHolidayGroups()
    {
        for (var month = 1; month <= 12; month++)
        {
            var monthStart = new DateOnly(_selectedYear, month, 1);
            var monthEnd = monthStart.AddMonths(1).AddDays(-1);
            var monthHolidays = _holidays
                .Where(h => h.FromDate <= monthEnd && h.ToDate >= monthStart)
                .OrderBy(h => h.FromDate)
                .ThenBy(h => h.Name)
                .ToList();

            if (monthHolidays.Count == 0)
            {
                continue;
            }

            yield return new HolidayGroup(month, monthStart.ToString("MMMM"), monthHolidays);
        }
    }

    private static string FormatDateRange(HolidayDto holiday)
    {
        if (holiday.FromDate == holiday.ToDate)
        {
            return holiday.FromDate.ToString("dddd, d MMMM");
        }

        if (holiday.FromDate.Year == holiday.ToDate.Year)
        {
            if (holiday.FromDate.Month == holiday.ToDate.Month)
            {
                return $"{holiday.FromDate:d} – {holiday.ToDate:d MMMM}";
            }

            return $"{holiday.FromDate:d MMM} – {holiday.ToDate:d MMM}";
        }

        return $"{holiday.FromDate:d MMM yyyy} – {holiday.ToDate:d MMM yyyy}";
    }

    private static string GetQuarterClass(string label) => label switch
    {
        "Q1" => "holiday-quarter-q1",
        "Q2" => "holiday-quarter-q2",
        "Q3" => "holiday-quarter-q3",
        _ => "holiday-quarter-q4"
    };

    private int GetQuarterHolidayCount(IReadOnlyList<int> months)
    {
        var monthStart = new DateOnly(_selectedYear, months.Min(), 1);
        var monthEnd = new DateOnly(_selectedYear, months.Max(), 1).AddMonths(1).AddDays(-1);
        return _holidays.Count(h => h.FromDate <= monthEnd && h.ToDate >= monthStart);
    }

    private static string FormatDateBadge(HolidayDto holiday)
    {
        if (holiday.FromDate == holiday.ToDate)
        {
            return holiday.FromDate.Day.ToString();
        }

        if (holiday.FromDate.Month == holiday.ToDate.Month)
        {
            return $"{holiday.FromDate.Day}–{holiday.ToDate.Day}";
        }

        return $"{holiday.FromDate:MMM d}–{holiday.ToDate:MMM d}";
    }

    private static int GetDurationDays(HolidayDto holiday) =>
        holiday.ToDate.DayNumber - holiday.FromDate.DayNumber + 1;

    private int GetTotalDaysOff() =>
        _holidays.Sum(GetDurationDays);

    private string GetNextHolidayLabel()
    {
        if (_holidays.Count == 0)
        {
            return "None scheduled";
        }

        var referenceDate = _selectedYear == _today.Year ? _today : new DateOnly(_selectedYear, 1, 1);
        var upcoming = _holidays
            .Where(h => h.ToDate >= referenceDate)
            .OrderBy(h => h.FromDate)
            .FirstOrDefault();

        if (upcoming is null)
        {
            return _selectedYear < _today.Year ? "Year completed" : "None remaining";
        }

        var range = upcoming.FromDate == upcoming.ToDate
            ? upcoming.FromDate.ToString("d MMM")
            : $"{upcoming.FromDate:d MMM} – {upcoming.ToDate:d MMM}";

        return $"{upcoming.Name} · {range}";
    }

    private static IEnumerable<HolidayQuarter> GetQuarters()
    {
        yield return new HolidayQuarter("Q1", "January – March", [1, 2, 3]);
        yield return new HolidayQuarter("Q2", "April – June", [4, 5, 6]);
        yield return new HolidayQuarter("Q3", "July – September", [7, 8, 9]);
        yield return new HolidayQuarter("Q4", "October – December", [10, 11, 12]);
    }

    private static string ExtractErrorMessage(string raw)
    {
        const string prefix = "Failed to ";
        var index = raw.IndexOf("\"error\":", StringComparison.OrdinalIgnoreCase);
        if (index >= 0)
        {
            var start = raw.IndexOf('"', index + 8);
            var end = raw.IndexOf('"', start + 1);
            if (start >= 0 && end > start)
            {
                return raw[(start + 1)..end];
            }
        }

        return raw.StartsWith(prefix, StringComparison.OrdinalIgnoreCase) ? raw : $"An error occurred: {raw}";
    }

    public async ValueTask DisposeAsync()
    {
        if (_holidayCalendarModule is null)
        {
            return;
        }

        try
        {
            await _holidayCalendarModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // Page is unloading.
        }
    }

