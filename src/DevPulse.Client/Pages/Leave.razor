@page "/leave"
@attribute [Authorize]
@inject ILeaveApiClient LeaveApi
@inject ToastService Toast

<PageTitle>@AppBranding.PageTitle("Leave")</PageTitle>

<div class="leave-page">
    <div class="analytics-hero analytics-hero-compact leave-hero">
        <div class="analytics-hero-copy">
            <p class="analytics-eyebrow">Company · Time Off</p>
            <h1>Leave Management</h1>
            <p class="analytics-lead">
                Apply for time off, track requests, and review applications assigned to you.
            </p>
        </div>
    </div>

    @if (_isLoading)
    {
        <LoadingIndicator Text="Loading leave data..." />
    }
    else if (!_me.CanApply && _me.DeveloperId is null)
    {
        <div class="leave-notice leave-notice-warning">
            <strong>Developer profile required</strong>
            <p class="mb-0">
                Your login email is not linked to a Developer record. Ask an administrator to match your user email with your Developer email in ClickUp.
            </p>
        </div>
    }
    else
    {
        <div class="leave-workspace">
            <div class="filter-card card leave-toolbar">
                <div class="card-body d-flex justify-content-end">
                    <button type="button"
                            class="btn btn-primary"
                            @onclick="OpenApplyModal">
                        <span class="bi-calendar-plus me-1" aria-hidden="true"></span>
                        Apply for leave
                    </button>
                </div>
            </div>

            <div class="leave-review-layout @(_reviewingApplication is not null ? "has-review" : null)">
                @if (_reviewingApplication is not null)
                {
                    <div class="filter-card card leave-review-card">
                        <div class="card-body">
                            <div class="leave-review-header">
                                <div>
                                    <span class="filter-section-label">Review request</span>
                                    <h2 class="leave-review-title">
                                        @_reviewingApplication.ApplicantName
                                    </h2>
                                    <p class="leave-review-subtitle mb-0">
                                        @_reviewingApplication.LeaveTypeName ·
                                        @FormatRange(_reviewingApplication.FromDate, _reviewingApplication.ToDate)
                                        · @_reviewingApplication.RequestedDays.ToString("0.#")
                                        @(_reviewingApplication.RequestedDays == 1 ? "day" : "days")
                                    </p>
                                </div>

                                <span class="leave-status-badge leave-status-pending">
                                    Pending
                                </span>
                            </div>

                            <div class="leave-review-reason">
                                <span class="leave-review-reason-label">Reason</span>
                                <p>@_reviewingApplication.Reason</p>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">
                                    Comment <span class="text-muted fw-normal">(optional)</span>
                                </label>
                                <textarea class="form-control"
                                          rows="2"
                                          @bind="_reviewComment"
                                          placeholder="Add a note for the applicant or team"></textarea>
                            </div>

                            <div class="leave-review-actions">
                                <BusyButton CssClass="btn btn-success"
                                            IsBusy="_isBusy"
                                            BusyText="Approving..."
                                            OnClick="ApproveAsync">
                                    Approve
                                </BusyButton>

                                <BusyButton CssClass="btn btn-outline-danger"
                                            IsBusy="_isBusy"
                                            BusyText="Rejecting..."
                                            OnClick="RejectAsync">
                                    Reject
                                </BusyButton>

                                <button type="button"
                                        class="btn btn-link leave-review-cancel"
                                        @onclick="CancelReview">
                                    Cancel
                                </button>
                            </div>
                        </div>
                    </div>
                }

                @RenderAllApplications()
            </div>
        </div>

        @if (_showApplyModal)
        {
            <div class="modal-backdrop fade show"></div>

            <div class="modal fade show d-block"
                 tabindex="-1"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="applyLeaveModalTitle">
                <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
                    <div class="modal-content">
                        <div class="modal-header">
                            <div>
                                <h5 class="modal-title" id="applyLeaveModalTitle">New leave application</h5>
                                <p class="text-muted small mb-0">
                                    Working days are counted from your leave policy.
                                </p>
                            </div>

                            <button type="button"
                                    class="btn-close"
                                    aria-label="Close"
                                    disabled="@_isBusy"
                                    @onclick="CloseApplyModal">
                            </button>
                        </div>

                        <div class="modal-body">
                            @if (!_me.CanApply)
                            {
                                <div class="leave-notice leave-notice-warning">
                                    <strong>Account inactive</strong>
                                    <p class="mb-0">
                                        Your developer record is inactive. Contact an administrator.
                                    </p>
                                </div>
                            }
                            else if (_me.ReportingManagerDeveloperId is null)
                            {
                                <div class="leave-notice leave-notice-warning">
                                    <strong>Reporting manager required</strong>
                                    <p class="mb-0">
                                        No reporting manager is assigned to your developer profile.
                                        Ask an administrator to assign one on the Developers page before applying for leave.
                                    </p>
                                </div>
                            }
                            else
                            {
                                <div class="leave-form-grid">
                                    <div class="leave-field leave-field-type">
                                        <label class="form-label">Leave type</label>
                                        <select class="form-select"
                                                @bind="_selectedLeaveTypeId"
                                                @bind:after="OnLeaveTypeOrDatesChanged">
                                            <option value="@Guid.Empty">Select type...</option>

                                            @foreach (var type in _activeLeaveTypes)
                                            {
                                                <option value="@type.Id">
                                                    @type.Name (@type.DaysPerYear days/year)
                                                </option>
                                            }
                                        </select>

                                        @if (_selectedLeaveType is not null &&
                                             !string.IsNullOrWhiteSpace(_selectedLeaveType.PolicyNotes))
                                        {
                                            <div class="form-text leave-policy-note">
                                                @_selectedLeaveType.PolicyNotes
                                            </div>
                                        }
                                    </div>

                                    <div class="leave-field">
                                        <label class="form-label">From</label>
                                        <input type="date"
                                               class="form-control"
                                               @bind="_fromDate"
                                               @bind:format="yyyy-MM-dd"
                                               @bind:after="OnLeaveTypeOrDatesChanged" />
                                    </div>

                                    <div class="leave-field">
                                        <label class="form-label">To</label>
                                        <input type="date"
                                               class="form-control"
                                               @bind="_toDate"
                                               @bind:format="yyyy-MM-dd"
                                               @bind:after="OnLeaveTypeOrDatesChanged" />
                                    </div>

                                    <div class="leave-field">
                                        <label class="form-label">Working days</label>
                                        <div class="leave-days-display">
                                            @if (_calculatedDays.HasValue)
                                            {
                                                <span class="leave-days-value">
                                                    @_calculatedDays.Value.ToString("0.#")
                                                </span>
                                                <span class="leave-days-label">
                                                    @(_calculatedDays.Value == 1 ? "day" : "days")
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="leave-days-placeholder">Select dates</span>
                                            }
                                        </div>
                                    </div>

                                    <div class="leave-field leave-field-approver">
                                        <label class="form-label">Reporting manager</label>
                                        <div class="leave-approver-chip">
                                            <span class="leave-approver-name">
                                                @_me.ReportingManagerName
                                            </span>
                                            <span class="leave-approver-note">
                                                Requests go to your assigned manager.
                                            </span>
                                        </div>
                                    </div>

                                    <div class="leave-field leave-field-reason">
                                        <label class="form-label">Reason</label>
                                        <textarea class="form-control leave-reason-input"
                                                  rows="3"
                                                  @bind="_reason"
                                                  placeholder="Brief reason for your leave request"></textarea>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="modal-footer">
                            <button type="button"
                                    class="btn btn-outline-secondary"
                                    disabled="@_isBusy"
                                    @onclick="CloseApplyModal">
                                Cancel
                            </button>

                            @if (_me.CanApply && _me.ReportingManagerDeveloperId is not null)
                            {
                                <BusyButton CssClass="btn btn-primary leave-submit-btn"
                                            IsBusy="_isBusy"
                                            BusyText="Submitting..."
                                            OnClick="SubmitAsync">
                                    Submit application
                                </BusyButton>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    private LeaveMeDto _me = new(null, null, false);

    private List<LeaveTypeDto> _activeLeaveTypes = [];
    private List<LeaveApplicationDto> _myApplications = [];
    private List<LeaveApplicationDto> _pendingApplications = [];

    private LeaveApplicationDto? _reviewingApplication;
    private LeaveTypeDto? _selectedLeaveType;

    private bool _isLoading = true;
    private bool _isBusy;

    private Guid _selectedLeaveTypeId;

    private DateOnly _fromDate = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly _toDate = DateOnly.FromDateTime(DateTime.Today);

    private decimal? _calculatedDays;

    private string _reason = string.Empty;
    private string? _reviewComment;
    private bool _showApplyModal;

    private void OpenApplyModal()
    {
        _showApplyModal = true;
    }

    private void CloseApplyModal()
    {
        if (!_isBusy)
        {
            _showApplyModal = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;

        try
        {
            _me = await LeaveApi.GetMeAsync();

            _activeLeaveTypes = (await LeaveApi.GetLeaveTypesAsync(activeOnly: true)).ToList();

            _myApplications = (await LeaveApi.GetMyApplicationsAsync()).ToList();

            _pendingApplications = (await LeaveApi.GetPendingForApprovalAsync()).ToList();

        }
        catch (Exception ex)
        {
            ShowMessage(ex.Message, true);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnLeaveTypeOrDatesChanged()
    {
        _selectedLeaveType = _activeLeaveTypes.FirstOrDefault(
            t => t.Id == _selectedLeaveTypeId);

        _calculatedDays = null;

        if (_selectedLeaveTypeId == Guid.Empty || _toDate < _fromDate)
        {
            return;
        }

        try
        {
            var result = await LeaveApi.CalculateDaysAsync(
                new LeaveDayCountRequest(
                    _selectedLeaveTypeId,
                    _fromDate,
                    _toDate));

            _calculatedDays = result?.Days;
        }
        catch
        {
            _calculatedDays = null;
        }
    }

    private async Task SubmitAsync()
    {
        if (_selectedLeaveTypeId == Guid.Empty ||
            _me.ReportingManagerDeveloperId is null)
        {
            ShowMessage(
                "Select a leave type. A reporting manager must be assigned before you can apply.",
                true);

            return;
        }

        _isBusy = true;

        try
        {
            await LeaveApi.SubmitApplicationAsync(
                new CreateLeaveApplicationRequest(
                    _selectedLeaveTypeId,
                    _fromDate,
                    _toDate,
                    _reason,
                    _me.ReportingManagerDeveloperId.Value));

            ShowMessage(
                "Leave application submitted. Your team will be notified on Telegram.",
                false);

            _reason = string.Empty;
            _calculatedDays = null;
            _selectedLeaveTypeId = Guid.Empty;
            _selectedLeaveType = null;
            _showApplyModal = false;

            await LoadAsync();

        }
        catch (Exception ex)
        {
            ShowMessage(ex.Message, true);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void StartReview(LeaveApplicationDto app)
    {
        _reviewingApplication = app;
        _reviewComment = null;
    }

    private void CancelReview()
    {
        _reviewingApplication = null;
    }

    private async Task ApproveAsync()
    {
        if (_reviewingApplication is null)
        {
            return;
        }

        _isBusy = true;

        try
        {
            await LeaveApi.ApproveAsync(
                _reviewingApplication.Id,
                new ReviewLeaveApplicationRequest(_reviewComment));

            ShowMessage("Leave approved. Team notified on Telegram.", false);

            _reviewingApplication = null;

            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowMessage(ex.Message, true);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task RejectAsync()
    {
        if (_reviewingApplication is null)
        {
            return;
        }

        _isBusy = true;

        try
        {
            await LeaveApi.RejectAsync(
                _reviewingApplication.Id,
                new ReviewLeaveApplicationRequest(_reviewComment));

            ShowMessage("Leave rejected. Team notified on Telegram.", false);

            _reviewingApplication = null;

            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowMessage(ex.Message, true);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task CancelApplicationAsync(Guid id)
    {
        _isBusy = true;

        try
        {
            await LeaveApi.CancelAsync(id);

            ShowMessage("Application cancelled.", false);

            await LoadAsync();
        }
        catch (Exception ex)
        {
            ShowMessage(ex.Message, true);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private sealed record LeaveApplicationRow(
        LeaveApplicationDto Application,
        bool IsMine,
        bool CanReview);

    private IReadOnlyList<LeaveApplicationRow> AllApplications =>
        _myApplications
            .Select(app => new LeaveApplicationRow(
                app,
                IsMine: true,
                CanReview: _pendingApplications.Any(p => p.Id == app.Id)))
            .Concat(
                _pendingApplications
                    .Where(pending => !_myApplications.Any(mine => mine.Id == pending.Id))
                    .Select(app => new LeaveApplicationRow(
                        app,
                        IsMine: false,
                        CanReview: true)))
            .OrderByDescending(row => row.Application.FromDate)
            .ToList();

    private RenderFragment RenderAllApplications() => @<div class="data-card card leave-applications-card">
        <div class="card-title-bar d-flex align-items-center justify-content-between gap-2">
            <h2 class="leave-list-title mb-0">Leave applications</h2>
            <span class="filter-count-badge">@AllApplications.Count</span>
        </div>

        <div class="card-body p-0">
            @if (AllApplications.Count == 0)
            {
                <div class="leave-empty-state">
                    <div class="leave-empty-icon"></div>
                    <h3>No leave applications</h3>
                    <p>Submitted applications and requests assigned to you for approval will appear here.</p>
                </div>
            }
            else
            {
                <div class="table-responsive leave-table-scroll">
                    <table class="table table-hover align-middle mb-0 leave-table">
                        <thead>
                            <tr>
                                <th>Employee</th>
                                <th>Type</th>
                                <th>Dates</th>
                                <th>Days</th>
                                <th>Approver</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in AllApplications)
                            {
                                var app = row.Application;
                                <tr class="@(row.CanReview && _reviewingApplication?.Id == app.Id ? "leave-row-reviewing" : null)">
                                    <td class="leave-table-primary">@app.ApplicantName</td>
                                    <td>@app.LeaveTypeName</td>
                                    <td class="leave-table-dates">@FormatRange(app.FromDate, app.ToDate)</td>
                                    <td>@app.RequestedDays.ToString("0.#")</td>
                                    <td>@app.ApproverName</td>
                                    <td>
                                        <span class="leave-status-badge @GetStatusBadgeClass(app.Status)">
                                            @GetStatusLabel(app.Status)
                                        </span>
                                    </td>
                                    <td class="text-end leave-table-actions">
                                        @if (row.CanReview && app.Status == LeaveApplicationStatusDto.Pending)
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-primary"
                                                    @onclick="() => StartReview(app)">
                                                Review
                                            </button>
                                        }

                                        @if (row.IsMine && app.Status == LeaveApplicationStatusDto.Pending)
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-secondary"
                                                    @onclick="() => CancelApplicationAsync(app.Id)">
                                                Cancel
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>;

    private static string FormatRange(DateOnly from, DateOnly to) =>
        from == to
            ? from.ToString("dd MMM yyyy")
            : $"{from:dd MMM yyyy} – {to:dd MMM yyyy}";

    private static string GetStatusBadgeClass(LeaveApplicationStatusDto status) =>
        status switch
        {
            LeaveApplicationStatusDto.Approved => "leave-status-approved",
            LeaveApplicationStatusDto.Rejected => "leave-status-rejected",
            LeaveApplicationStatusDto.Cancelled => "leave-status-cancelled",
            _ => "leave-status-pending"
        };

    private static string GetStatusLabel(LeaveApplicationStatusDto status) =>
        status switch
        {
            LeaveApplicationStatusDto.Approved => "Approved",
            LeaveApplicationStatusDto.Rejected => "Rejected",
            LeaveApplicationStatusDto.Cancelled => "Cancelled",
            _ => "Pending"
        };

    private void ShowMessage(string message, bool isError)
    {
        if (isError)
        {
            Toast.Error(message, key: ToastKeys.Leave);
        }
        else
        {
            Toast.Success(message, key: ToastKeys.Leave);
        }
    }
}
