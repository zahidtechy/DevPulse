@page "/change-password"
@attribute [Authorize]
@inject IAuthService AuthService

<PageTitle>@AppBranding.PageTitle("Change Password")</PageTitle>

<div class="page-header">
    <div>
        <h1>Change Password</h1>
        <p class="text-muted">Update your account password.</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_message))
{
    <div class="alert @(_isError ? "alert-danger" : "alert-success")" role="alert">@_message</div>
}

<div class="form-card card">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Current Password</label>
                <input type="password" class="form-control" @bind="_currentPassword" autocomplete="current-password" />
            </div>
            <div class="col-md-4">
                <label class="form-label">New Password</label>
                <input type="password" class="form-control" @bind="_newPassword" autocomplete="new-password" />
                <div class="form-text">At least 8 characters with uppercase, lowercase, digit, and special character.</div>
            </div>
            <div class="col-md-4">
                <label class="form-label">Confirm New Password</label>
                <input type="password" class="form-control" @bind="_confirmPassword" autocomplete="new-password" />
            </div>
        </div>
        <div class="mt-3">
            <BusyButton CssClass="btn btn-primary" IsBusy="_isBusy" BusyText="Saving..." OnClick="ChangePasswordAsync">
                Change Password
            </BusyButton>
        </div>
    </div>
</div>

@code {
    private string _currentPassword = string.Empty;
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private bool _isBusy;
    private bool _isError;
    private string? _message;

    private async Task ChangePasswordAsync()
    {
        _message = null;

        if (string.IsNullOrWhiteSpace(_currentPassword))
        {
            _isError = true;
            _message = "Current password is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_newPassword))
        {
            _isError = true;
            _message = "New password is required.";
            return;
        }

        if (_newPassword != _confirmPassword)
        {
            _isError = true;
            _message = "New passwords do not match.";
            return;
        }

        _isBusy = true;

        try
        {
            await AuthService.ChangePasswordAsync(new SelfChangePasswordRequest(_currentPassword, _newPassword));
            _isError = false;
            _message = "Password changed successfully.";
            _currentPassword = string.Empty;
            _newPassword = string.Empty;
            _confirmPassword = string.Empty;
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }
}
